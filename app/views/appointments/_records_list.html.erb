<div class="appointments-records">
  <% if @appointments_by_month.any? %>
    <% @appointments_by_month.each_with_index do |(month, appointments), index| %>
      <section class="appointments-month-group" data-controller="collapse">

        <button type="button" class="appointments-month-header" data-action="click->collapse#toggle">

          <span class="appointments-month-title">
            <%= l(month, format: "%B %Y") %>
          </span>

          <span class="appointments-month-meta">
            <%= t( "appointments.history.records", count: appointments.size) %>

            <span class="appointments-month-chevron" aria-hidden="true">
              ›
            </span>
          </span>
        </button>

        <ul class="appointments-record-list collapsible <%= "hidden" unless index.zero? %>" data-collapse-target="content">

          <% appointments
               .sort_by { |appointment| [ appointment.appointment_date, appointment.appointment_time ] }
               .reverse_each do |appointment| %>

            <li class="appointment-record">
              <div class="appointment-record-header">
                <%= link_to edit_appointment_path(appointment), class: "appointment-record-content" do %>

                  <div class="appointment-record-date">
                    <%= l(appointment.appointment_date, format: :default) %>

                    <span class="appointment-record-time">
                      <%= appointment.appointment_time.strftime("%H:%M") %>

                      <% if appointment.end_time.present? %>
                        –
                        <%= appointment.end_time.strftime("%H:%M") %>
                      <% end %>
                    </span>
                  </div>

                  <div class="appointment-record-client">
                    <%= appointment.client.full_name %>
                  </div>

                  <% if appointment.service_name.present? %>
                    <div class="appointment-record-services">
                      <% appointment.service_name.split(" + ").each do |service| %>
                        <span class="appointment-record-service">
                          <%= service %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                <% end %>

                <div class="appointment-record-actions">
                  <%= link_to client_path(appointment.client), class: "appointment-action-button", data: { turbo: false }, aria: { label: t("appointments.actions.client") } do %>
                    <%= image_tag "client.png", class: "appointment-action-icon", width: 16, height: 16, alt: "" %>
                  <% end %>

                  <% if appointment.service_note.present? %>
                    <%= link_to client_service_note_path(appointment.client, appointment.service_note), class: "appointment-action-button",
                          data: { turbo: false }, aria: { label: t("appointments.actions.service_note") } do %>
                      <%= image_tag "notes.png", class: "appointment-action-icon", width: 16, height: 16, alt: "" %>
                    <% end %>
                  <% elsif !appointment.client.archived? %>
                    <%= link_to new_client_service_note_path(appointment.client, appointment_id: appointment.id), class: "appointment-action-button",
                                data: { turbo: false }, aria: {label: t("appointments.actions.service_note") } do %>
                      <%= image_tag "notes.png", class: "appointment-action-icon", width: 16, height: 16, alt: "" %>
                    <% end %>
                  <% end %>

                  <%= button_to appointment_path(appointment), method: :delete, form: { data: { turbo_confirm: t("appointments.confirm.delete") } },
                                class: "appointment-action-button appointment-delete-button", aria: { label: t("appointments.actions.delete") } do %>
                    <%= image_tag "delete.png", class: "appointment-action-icon", width: 16, height: 16, alt: "" %>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <div class="appointments-empty">
      <%= image_tag "sad.png", class: "appointments-empty-icon", alt: "" %>

      <p class="appointments-empty-text">
        <%= t("appointments.history.empty") %>
      </p>
    </div>
  <% end %>
</div>
