<% service_prices = @appointment.appointment_services_relations.pluck(:service_id, :price).to_h %>

<div class="appointment-container"
     data-controller="unsaved-changes"
     data-unsaved-changes-back-url-value="<%= calendar_appointments_path %>"
     data-unsaved-changes-initial-dirty-value="<%= @appointment.errors.any? %>">

  <%= form_with model: @appointment, local: true,
      data: {
        controller: "calendar appointment service-selector working-hours",
        action: "appointment:slot-selected->working-hours#checkTime",
        appointment_nothing_selected_value: t("appointments.nothing_selected"),
        appointment_free_slots_url_value: free_slots_appointments_path,
        appointment_no_free_slots_value: t("appointments.slots.no_free_slots"),
        service_selector_input_name_value: "appointment[service_ids][]",
        service_selector_checkbox_name_value: "appointment[modal_dummy][]",
        service_selector_placeholder_class_value: "add-service-placeholder",
        service_selector_close_icon_value: asset_path("close.png"),
        service_selector_prices_value: service_prices.to_json,
        working_hours_url_value: check_working_hours_appointments_path,
        working_hours_mode_value: "form",
        working_hours_day_off_message_value: t("appointments.working_hours.day_off"),
        working_hours_outside_hours_message_value: t("appointments.working_hours.outside_hours"),
        working_hours_error_message_value: t("appointments.working_hours.error"),
        unsaved_changes_target: "form"
      } do |f| %>
    <div class="appointment-header">
      <div class="appointment-header-left">
        <button type="button" class="back-link inline" aria-label="<%= t('wizard.back') %>" data-action="click->unsaved-changes#close">
          <%= image_tag "back.png", class: "wiz-icon", width: 24, height: 24 %>
        </button>
        <h2>
          <%= @appointment.new_record? ? t("appointments.new") : t("appointments.edit") %>
        </h2>
      </div>

      <button type="submit" class="appointment-save-button" data-appointment-target="saveButton">
        <%= t("common.save").upcase %>
      </button>
    </div>
    <!-- Client Name -->
    <div class="client-input-wrapper">
      <label>
        <%= t("appointments.form.client_name") %>
        <span class="required-asterisk">*</span>
      </label>
      <%= text_field_tag "appointment[client_name]",
        @appointment.client_name,
        class: "form-input client-name-input",
        placeholder: t("appointments.form.client_name_placeholder"),
        data: {"calendar-target": "clientName",
          action: "input->calendar#updateClientInfo keyup->calendar#toggleClearButton focus->calendar#toggleClearButton"
        },
        list: "client-list", autocomplete: "off" %>

      <% @appointment.errors.where(:client_name).each do |error| %>
        <div class="inline-error" role="alert">
          <%= error.message %>
        </div>
      <% end %>

      <button type="button" class="clear-client-btn hidden" data-calendar-target="clearButton" data-action="click->calendar#clearClientField">
        <%= image_tag "close.png", class: "clear-icon" %>
      </button>

      <datalist id="client-list" data-calendar-target="clientList">
        <% current_user.clients.each do |client| %>
          <option value="<%= client.full_name %>" data-phone="<%= client.phone %>">
        <% end %>
      </datalist>
    </div>
    <!-- Phone -->
    <div class="form-section">
      <label>
        <%= t("appointments.form.phone") %>
        <span class="required-asterisk">*</span>
      </label>

      <div class="phone-input-wrapper">
        <%= telephone_field_tag "appointment[phone]",
            @appointment.phone.presence || @appointment.client&.phone, class: "form-input", autocomplete: "tel",
          data: { controller: "phone-mask", "calendar-target": "clientPhone" } %>
      </div>

      <% @appointment.errors.where(:phone).each do |error| %>
        <div class="inline-error" role="alert">
          <%= error.message %>
        </div>
      <% end %>
    </div>
    <!-- Date -->
    <div class="form-section">
      <label>
        <%= t("appointments.form.date") %>
        <span class="required-asterisk">*</span>
      </label>

      <%= text_field_tag "appointment[appointment_date]",
          (@appointment.appointment_date || Date.current).strftime("%d.%m.%Y"),
          class: "form-input", readonly: true, id: "appointment_date",
          data: {
            controller: "datepicker",
            datepicker_target: "input",
            appointment_target: "date",
            working_hours_target: "date",
            action: "datepicker:selected->appointment#loadSlots datepicker:selected->working-hours#checkDate",
            min: Date.current.strftime("%Y-%m-%d")
          } %>

      <% @appointment.errors.where(:appointment_date).each do |error| %>
        <div class="inline-error" role="alert">
          <%= error.message %>
        </div>
      <% end %>
    </div>
    <!-- Start / End Time -->
    <div class="form-section double appointment-time-fields">
      <div class="appointment-time-field">
        <%= f.label :appointment_time, class: "appointment-time-label" do %>
          <%= t("appointments.form.start_time") %>
          <span class="required-asterisk">*</span>
        <% end %>

        <%= f.time_field :appointment_time, step: 300, class: "form-input",
          data: {
            appointment_target: "appointmentTime",
            working_hours_target: "startTime",
            action: [
              "blur->appointment#roundToNearestFive",
              "change->appointment#roundToNearestFive",
              "input->appointment#validateTimes",
              "change->appointment#validateTimes",
              "change->working-hours#checkTime"
            ].join(" ")
          } %>

        <% @appointment.errors.where(:appointment_time).each do |error| %>
          <div class="inline-error" role="alert">
            <%= error.message %>
          </div>
        <% end %>
      </div>

      <div class="appointment-time-field">
        <%= f.label :end_time, class: "appointment-time-label" do %>
          <%= t("appointments.form.end_time") %>
          <span class="required-asterisk">*</span>
        <% end %>

        <%= f.time_field :end_time, step: 300, class: "form-input",
          data: {
            appointment_target: "endTime",
            working_hours_target: "endTime",
            action: [
              "blur->appointment#roundToNearestFive",
              "change->appointment#roundToNearestFive",
              "input->appointment#validateTimes",
              "change->appointment#validateTimes",
              "change->working-hours#checkTime"
            ].join(" ")
          } %>

        <% @appointment.errors.where(:end_time).each do |error| %>
          <div class="inline-error" role="alert">
            <%= error.message %>
          </div>
        <% end %>

        <div data-appointment-target="timeError" class="inline-error hidden">
          <%= t("appointments.form.end_time_error") %>
        </div>
      </div>
    </div>
    <!-- Available Slots -->
    <div class="appointment-slots" data-appointment-target="slots">
      <div class="appointment-slots-title">
        <%= t("appointments.form.slots") %>
      </div>

      <div class="appointment-slots-list"
           data-appointment-target="slotsList">
      </div>
    </div>
    <!-- Main Services -->
    <%= render "shared/service_selector",
      label: t("appointments.form.services"),
      selected_ids: @appointment.service_ids,
      selected_names: @appointment.services.map(&:name).join(", ") %>
    <!-- Notes -->
    <div class="form-section">
      <%= f.label :notes, t("appointments.form.notes") %>
      <%= f.text_area :notes, class: "form-input textarea-auto", maxlength: 256, rows: 2,
        placeholder: t("appointments.form.notes_placeholder") %>
    </div>
    <!-- Modals -->
    <%= render("shared/modals/service_selector", checkbox_name: "appointment[modal_dummy][]") %>
    <%= render "shared/modals/working_hours" %>
  <% end %>

  <%= render "shared/modals/unsaved_changes" %>
</div>
