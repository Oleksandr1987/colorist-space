<div class="appointments-history"
     data-controller="appointments-filter"
     data-appointments-filter-first-date-value="<%= @period_first_date&.iso8601 %>"
     data-appointments-filter-last-date-value="<%= @period_last_date&.iso8601 %>"
     data-appointments-filter-options-url-value="<%= filter_options_appointments_path %>">

  <div class="appointments-history-header">
    <h1 class="appointments-history-title">
      <%= t("appointments.title") %>
    </h1>
  </div>

  <% selected_year = (params[:year].presence || Date.current.year).to_i %>
  <% selected_month = (params[:month].presence || Date.current.month).to_i %>
  <% selected_month_date = Date.new(selected_year, selected_month, 1) %>
  <% custom_period_active = params[:from].present? || params[:to].present? || params[:all_time] == "1" %>

  <!-- DASHBOARD -->
  <div class="appointments-dashboard">
    <button type="button"
            class="dashboard-card <%= 'active' if params[:year].blank? && !custom_period_active %>"
            data-action="click->appointments-filter#showAllYears">
      <span class="dashboard-label">
        <%= t("appointments.dashboard.total", count: @stats[:total]) %>
      </span>
    </button>

    <button type="button"
            class="dashboard-card <%= 'active' if params[:year].present? && params[:month].blank? && !custom_period_active %>"
            data-year="<%= selected_year %>"
            data-action="click->appointments-filter#filterYear">
      <span class="dashboard-label">
        <%= t("appointments.dashboard.year", count: @stats[:current_year], year: selected_year) %>
      </span>
    </button>

    <button type="button"
            class="dashboard-card <%= 'active' if params[:month].present? && !custom_period_active %>"
            data-year="<%= selected_year %>"
            data-month="<%= selected_month %>"
            data-action="click->appointments-filter#filterMonth">
      <span class="dashboard-label">
        <%= t("appointments.dashboard.month", count: @stats[:current_month], month: l(selected_month_date, format: "%B").downcase) %>
      </span>
    </button>
  </div>

  <!-- SEARCH -->
  <div class="appointments-search">
    <%= form_with url: all_appointments_path, method: :get, local: true, class: "appointments-search-form" do %>

      <% request.query_parameters.except("query").each do |key, value| %>
        <% if value.is_a?(Array) %>
          <% value.each do |item| %>
            <%= hidden_field_tag "#{key}[]", item %>
          <% end %>
        <% else %>
          <%= hidden_field_tag key, value %>
        <% end %>
      <% end %>

      <%= text_field_tag :query, params[:query], class: "form-input appointments-search-input", placeholder: t("common.search") %>

      <% if params[:query].present? %>
        <%= link_to "×", all_appointments_path(request.query_parameters.except("query")), class: "appointments-search-clear", aria: { label: t("common.clear") } %>
      <% end %>
    <% end %>
  </div>

  <!-- RECORDS -->
  <div class="appointments-scroll-content">
    <%= render "records_list" %>
  </div>

  <!-- ACTIVE FILTERS -->
  <%
    selected_categories = Array(params[:categories]).reject(&:blank?)
    selected_services = Array(params[:service_ids]).reject(&:blank?)

    period_applied = params[:year].present? || params[:month].present? || params[:from].present? || params[:to].present?

    active_filters_count = selected_categories.size + selected_services.size + (period_applied ? 1 : 0)

    filters_applied = active_filters_count.positive?

    reset_filter_params = request.query_parameters.except("year", "month", "from", "to", "all_time", "categories", "service_ids")
  %>

  <!-- FLOATING FILTER ACTIONS -->
  <div class="appointments-filter-actions">

    <% if filters_applied %>
      <%= link_to all_appointments_path(reset_filter_params), class: "analytics-floating-reset-button" do %>
        <span><%= t("analytics.period_filter.cancel") %></span>
      <% end %>
    <% end %>

    <button type="button" class="analytics-floating-filter-button" data-action="click->appointments-filter#open">
      <%= image_tag "filter.png", class: "analytics-filter-icon", width: 28, height: 28 %>

      <span><%= t("analytics.period_filter.filter") %></span>

      <% if filters_applied %>
        <span class="appointments-filter-count">
          <%= active_filters_count %>
        </span>
      <% end %>
    </button>

  </div>

  <!-- FILTER MODAL -->
  <div class="analytics-filter-modal hidden"
       data-appointments-filter-target="modal"
       data-action="click->appointments-filter#closeOnOverlay">

    <div class="analytics-filter-modal-content">
      <form action="<%= all_appointments_path %>"
            method="get"
            class="analytics-filter-form"
            data-action="submit->appointments-filter#apply">

        <%= hidden_field_tag :query, params[:query] if params[:query].present? %>

        <!-- MODAL HEADER -->
        <div class="analytics-filter-modal-header">
          <button type="button" class="analytics-filter-close" data-action="click->appointments-filter#close" aria-label="<%= t('common.close') %>">

            <%= image_tag "close.png", class: "wiz-icon", width: 24, height: 24 %>
          </button>

          <h2><%= t("analytics.period_filter.filter") %></h2>

          <button type="submit" class="analytics-filter-save">
            <%= t("analytics.period_filter.apply").upcase %>
          </button>
        </div>

        <!-- FILTER CONTENT -->
        <div class="analytics-filter-form-content">

          <!-- PERIOD -->
          <%= render "shared/analytics_period_fields", from_date: @from_date, to_date: @to_date, all_time: @all_time, filter_controller: "appointments-filter" %>

          <!-- CATEGORIES -->
          <div class="filter-section">
            <div class="filter-title">
              <%= t("appointments.filters.categories") %>
            </div>

            <div class="filter-chips" data-appointments-filter-target="categories">
              <button type="button" class="filter-chip" data-filter-group="categories" data-filter-value="" data-action="click->appointments-filter#clearSelection">
                <%= t("common.all") %>
              </button>

              <% @available_categories.each do |category| %>
                <button type="button"
                        class="filter-chip <%= 'active' if selected_categories.include?(category) %>"
                        data-filter-group="categories"
                        data-filter-value="<%= category %>"
                        data-action="click->appointments-filter#toggleSelection"
                        aria-pressed="<%= selected_categories.include?(category) %>">
                  <%= Service.category_label(category) %>
                </button>
              <% end %>

            </div>
          </div>

          <!-- SERVICES -->
          <div class="filter-section" data-appointments-filter-target="servicesSection">
            <div class="filter-title">
              <%= t("appointments.filters.services") %>
            </div>

            <div class="filter-chips" data-appointments-filter-target="services">
              <button type="button" class="filter-chip" data-filter-group="service_ids" data-filter-value="" data-action="click->appointments-filter#clearSelection">
                <%= t("common.all") %>
              </button>

              <% @available_services.each do |service| %>
                <button type="button"
                        class="filter-chip <%= 'active' if selected_services.include?(service.id.to_s) %>"
                        data-filter-group="service_ids"
                        data-filter-value="<%= service.id %>"
                        data-service-category="<%= service.category %>"
                        data-action="click->appointments-filter#toggleSelection"
                        aria-pressed="<%= selected_services.include?(service.id.to_s) %>">
                  <%= service.subtype %>
                </button>
              <% end %>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
