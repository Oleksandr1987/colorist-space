<div class="appointments-history" data-controller="appointments-filter">

  <!-- HEADER -->
  <div class="appointments-history-header">
    <h1 class="appointments-history-title">
      <%= t("appointments.title") %>
    </h1>
  </div>

  <!-- DASHBOARD -->
  <div class="appointments-dashboard">
    <!-- ALL -->
    <button
      type="button"
      class="dashboard-card <%= "active" if params[:year].blank? %>"
      data-action="click->appointments-filter#showAllYears">

      <span class="dashboard-label">
        <%= t("appointments.dashboard.total", count: @stats[:total]) %>
      </span>
    </button>

    <!-- YEAR -->
    <button
      type="button"
      class="dashboard-card <%= "active" if params[:year].present? && params[:month].blank? %>"
      data-year="<%= params[:year].presence || Date.current.year %>"
      data-action="click->appointments-filter#filterYear">

      <span class="dashboard-label">
        <%= t(
              "appointments.dashboard.year",
              count: @stats[:current_year],
              year: params[:year].presence || Date.current.year
            ) %>
      </span>
    </button>

    <!-- MONTH -->
    <% selected_year = (params[:year].presence || Date.current.year).to_i %>
    <% selected_month = (params[:month].presence || Date.current.month).to_i %>
    <% selected_month_date = Date.new(selected_year, selected_month, 1) %>

    <button
      type="button"
      class="dashboard-card <%= "active" if params[:month].present? %>"
      data-year="<%= selected_year %>"
      data-month="<%= selected_month %>"
      data-action="click->appointments-filter#filterMonth">

      <span class="dashboard-label">
        <%= t(
              "appointments.dashboard.month",
              count: @stats[:current_month],
              month: l(selected_month_date, format: "%B").downcase
            ) %>
      </span>
    </button>
  </div>

  <!-- SEARCH -->
  <div class="appointments-search">
    <%= form_with url: all_appointments_path, method: :get, local: true, class: "appointments-search-form" do %>

      <% request.query_parameters.except("query").each do |key, value| %>
        <% Array(value).each do |item| %>
          <%= hidden_field_tag "#{key}[]", item if value.is_a?(Array) %>
        <% end %>

        <% unless value.is_a?(Array) %>
          <%= hidden_field_tag key, value %>
        <% end %>
      <% end %>

      <%= text_field_tag :query, params[:query], class: "form-input appointments-search-input", placeholder: t("common.search") %>

      <% if params[:query].present? %>
        <%= link_to all_appointments_path(request.query_parameters.except("query")), class: "appointments-search-clear", aria: { label: t("common.clear") } do %>
          ×
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- FILTERS -->
  <% active_filters_count = Array(params[:categories]).size + Array(params[:service_ids]).size %>

  <details
    class="appointments-filter-panel"
    <%= "open" if active_filters_count.positive? %>>

    <summary class="appointments-filter-summary">
      <span>
        <%= t("appointments.filters.title") %>
      </span>

      <% if active_filters_count.positive? %>
        <span class="appointments-filter-count">
          <%= active_filters_count %>
        </span>
      <% end %>
    </summary>

    <div class="appointments-filters">
      <!-- YEARS -->
      <div class="filter-section">
        <div class="filter-title">
          <%= t("appointments.filters.years") %>
        </div>

        <div class="filter-chips">
          <button
            type="button"
            class="filter-chip <%= "active" if params[:year].blank? %>"
            data-action="click->appointments-filter#showAllYears">
            <%= t("common.all") %>
          </button>

          <% @available_years.each do |year| %>
            <button
              type="button"
              class="filter-chip <%= "active" if params[:year].to_i == year %>"
              data-year="<%= year %>"
              data-action="click->appointments-filter#filterYear">
              <%= year %>
            </button>
          <% end %>
        </div>
      </div>

      <!-- CATEGORIES -->
      <div class="filter-section">
        <div class="filter-title">
          <%= t("appointments.filters.categories") %>
        </div>

        <div class="filter-chips">
          <button
            type="button"
            class="filter-chip <%= "active" if params[:categories].blank? %>"
            data-param="categories"
            data-action="click->appointments-filter#clearFilter">
            <%= t("common.all") %>
          </button>

          <% @available_categories.each do |category| %>
            <button
              type="button"
              class="filter-chip <%= "active" if Array(params[:categories]).include?(category) %>"
              data-param="categories"
              data-value="<%= category %>"
              data-action="click->appointments-filter#toggleFilter">
              <%= t("services.categories.#{category}") %>
            </button>
          <% end %>
        </div>
      </div>

      <!-- SERVICES -->
      <div class="filter-section">
        <div class="filter-title">
          <%= t("appointments.filters.services") %>
        </div>

        <div class="filter-chips">
          <button
            type="button"
            class="filter-chip <%= "active" if params[:service_ids].blank? %>"
            data-param="service_ids"
            data-action="click->appointments-filter#clearFilter">
            <%= t("common.all") %>
          </button>

          <% @available_services.each do |service| %>
            <button
              type="button"
              class="filter-chip <%= "active" if Array(params[:service_ids]).include?(service.id.to_s) %>"
              data-param="service_ids"
              data-value="<%= service.id %>"
              data-action="click->appointments-filter#toggleFilter">
              <%= service.subtype %>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </details>

  <!-- RECORDS -->
  <%= render "records_list" %>
</div>
