<div class="settings-page">
  <div class="settings-header">
    <h1>
      <%= t("settings.title") %>
    </h1>
  </div>

  <section class="settings-section">
    <h2 class="settings-section-title">
      <%= t("settings.account.title") %>
    </h2>

    <div class="settings-info-list">
      <% %w[name email phone].each do |field| %>
        <div class="settings-info-row">
          <span class="settings-label">
            <%= t("settings.account.#{field}") %>
          </span>
          <span class="settings-value">
            <%= @user.public_send(field).presence || "—" %>
          </span>
        </div>
      <% end %>
    </div>

    <div class="settings-links">
      <% %w[edit_profile change_password].each do |action| %>
        <%= link_to edit_user_registration_path, class: "settings-link" do %>
          <span>
            <%= t("settings.account.#{action}") %>
          </span>
          <span class="settings-chevron">
            ›
          </span>
        <% end %>
      <% end %>

      <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "settings-link muted" do %>
        <span>
          <%= t("settings.account.logout") %>
        </span>
        <span class="settings-chevron">
          ›
        </span>
      <% end %>

      <%= button_to registration_path(@user), method: :delete,
          form: { class: "settings-button-form", data: { turbo_confirm: t("settings.account.confirm_delete") } }, class: "settings-link danger" do %>
        <span>
          <%= t("settings.account.delete") %>
        </span>
        <span class="settings-chevron">
          ›
        </span>
      <% end %>
    </div>
  </section>

  <section class="settings-section">
    <h2 class="settings-section-title">
      <%= t("settings.language.title") %>
    </h2>
    <select class="input-line settings-language-select" aria-label="<%= t('settings.language.title') %>"
      onchange="window.location = window.location.pathname + '?locale=' + this.value;">
      <% %w[uk en].each do |locale| %>
        <option value="<%= locale %>" <%= "selected" if I18n.locale.to_s == locale %>>
          <%= t("settings.language.#{locale}") %>
        </option>
      <% end %>
    </select>
  </section>

  <section class="settings-section">
    <h2 class="settings-section-title">
      <%= t("settings.subscription.title") %>
    </h2>
    <div class="settings-info-list">
      <div class="settings-info-row">
        <span class="settings-label">
          <%= t("settings.subscription.plan") %>
        </span>
        <span class="settings-value subscription-plan">
          <%= t("subscription.plans.#{@user.subscription_plan}") %>
        </span>
      </div>

      <% unless @user.superadmin? %>
        <div class="settings-info-row">
          <span class="settings-label">
            <%= t("settings.subscription.active_until") %>
          </span>
          <span class="settings-value">
            <%= subscription_end_label(@user.subscription) %>
          </span>
        </div>
      <% end %>
    </div>

    <% if @user.subscription_will_expire_soon? %>
      <div class="subscription-warning">
        <%= t("settings.subscription.expires_soon") %>
      </div>
    <% elsif !@user.has_write_access? %>
      <div class="subscription-warning">
        <%= t("settings.subscription.expired") %>
      </div>
    <% end %>

    <%= link_to settings_subscription_path, class: "settings-link primary" do %>
      <span>
        <%= t("settings.subscription.manage") %>
      </span>
      <span class="settings-chevron">
        ›
      </span>
    <% end %>
  </section>
</div>
