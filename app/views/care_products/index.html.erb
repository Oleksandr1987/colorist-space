<%= turbo_stream_from current_user, "care_products" %>

<div class="service-wrapper" data-controller="service">
  <div class="category-header care-products-header">
    <div class="category-title">
      <%= link_to services_path, class: "back" do %>
        <%= image_tag "back.png", class: "wiz-icon", width: 24, height: 24 %>
      <% end %>

      <span><%= t("services.pages.care_products") %></span>
    </div>

    <div class="care-products-header-actions">
      <%= link_to archived_care_products_path,
        class: "care-products-archive-link",
        aria: { label: t("care_products.archive.view") } do %>
        <%= t("care_products.archive.view") %>
      <% end %>

      <%= link_to new_care_product_path, class: "formula-add-button" do %>
        <%= image_tag "plus.png", width: 24, height: 24 %>
      <% end %>
    </div>
  </div>

  <div class="care-products-page-search">
    <input type="text"
           placeholder="<%= t('services.pages.search') %>"
           class="formula-search-input"
           data-service-target="search"
           data-action="input->service#filter">
  </div>

  <div class="care-products-filters">
    <button type="button" class="filter-button active" data-category="" data-action="click->service#filterCategory">
      <%= t("common.all") %>
    </button>

    <% CareProduct.categories_for_user(current_user).each do |category| %>
      <button type="button" class="filter-button" data-category="<%= category.downcase %>" data-action="click->service#filterCategory">
        <%= CareProduct.category_label(category) %>
      </button>
    <% end %>
  </div>

  <% if @care_product.present? %>
    <%= render "care_products/form", care_product: @care_product %>
  <% end %>

  <div id="care_products" class="service-list scrollable-service-list" data-service-target="list">
    <%= render @care_products %>
  </div>
</div>
