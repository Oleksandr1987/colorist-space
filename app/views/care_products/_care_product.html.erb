<div id="<%= dom_id(care_product) %>"
     class="service-item"
     data-name="<%= "#{care_product.brand} #{care_product.name} #{care_product.category}".downcase %>"
     data-category="<%= care_product.category.to_s.downcase %>">

  <div class="service-info">
    <div class="service-name">
      <strong>
        <%= care_product.brand.presence || t("care_products.unknown_brand") %>
      </strong>

      <%= care_product.name %>
    </div>

    <% if care_product.category.present? %>
      <div class="service-category">
        <%= t("care_products.categories.#{care_product.category}", default: care_product.category) %>
      </div>
    <% end %>

    <div class="service-price">
      <%= t("care_products.sale_label") %>:
      <%= care_product.sale_price || 0 %> ₴
    </div>

    <% if care_product.purchase_price.present? %>
      <div class="service-purchase-price">
        <%= t("care_products.purchase") %>:
        <%= care_product.purchase_price %> ₴
      </div>
    <% end %>

    <% if care_product.stock_quantity.present? %>
      <div class="service-stock">
        <%= t("care_products.stock") %>:
        <%= care_product.stock_quantity %>
      </div>
    <% end %>

    <div class="care-product-actions">
      <% if care_product.stock_quantity.to_i.positive? %>
        <%= link_to new_care_product_sale_path(care_product), class: "care-product-action-button" do %>
          <%= t("care_products.sale.action") %>
        <% end %>
      <% else %>
        <span class="care-product-action-button disabled" aria-disabled="true">
          <%= t("care_products.sale.action") %>
        </span>
      <% end %>

      <%= link_to restock_care_product_path(care_product), class: "care-product-action-button" do %>
        <%= t("care_products.restock.action") %>
      <% end %>
    </div>

    <% if care_product.incomplete? %>
      <div class="care-product-warning">
        ⚠ <%= t("care_products.need_details") %>
      </div>
    <% end %>
  </div>

  <div class="service-actions">
    <%= link_to edit_care_product_path(care_product), class: "icon-button", aria: { label: t("common.edit") } do %>
      <%= image_tag "pencil.png", class: "wiz-icon", width: 16, height: 16, alt: t("common.edit") %>
    <% end %>

    <%= button_to care_product_path(care_product),
          method: :delete,
          class: "icon-button delete-button",
          aria: { label: t("common.delete") },
          form: { data: { turbo_confirm: t("care_products.confirm_delete") } } do %>
      <%= image_tag "delete.png", class: "wiz-icon", width: 16, height: 16, alt: t("common.delete") %>
    <% end %>
  </div>
</div>
