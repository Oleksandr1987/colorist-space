<% back_path = category.present? ? section_services_path(category: category) : main_services_path %>

<div class="service-form-wrapper">
  <div class="appointment-header modal-header">
    <div class="appointment-header-left">
      <%= link_to back_path, class: "back-link inline" do %>
        <%= image_tag "back.png", class: "wiz-icon", width: 24, height: 24 %>
      <% end %>

      <h2><%= title %></h2>
    </div>

    <button type="submit" form="service-form" class="wizard-save-button">
      <%= t("common.save").upcase %>
    </button>
  </div>

  <%= render "form", service: service %>
</div>
