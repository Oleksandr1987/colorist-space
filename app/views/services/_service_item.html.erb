<div class="service-item"
    data-name="<%= [service.subtype, service.unit, service.price].compact.join(' ').downcase %>">

  <div class="service-info">
    <strong><%= service.subtype %></strong>
    — <%= number_to_currency(service.price, unit: "", precision: 0) %> ₴
    <% if service.unit.present? %>
      (<%= service.unit %>)
    <% end %>
  </div>

  <div class="service-actions">
    <%= link_to edit_service_path(service), class: "icon-button" do %>
      <%= image_tag "pencil.png", class: "wiz-icon", width: 24, height: 24 %>
    <% end %>

    <%= button_to service_path(service),
        method: :delete,
        class: "icon-button delete-button",
        form: {
          data: {
            turbo_confirm: t("services.list.confirm_delete")
          }
        } do %>
      <%= image_tag "delete.png", class: "wiz-icon", width: 24, height: 24 %>
    <% end %>
  </div>
</div>
