<%
  filters_applied = params[:all_time] == "1" || params[:from].present? || params[:to].present? || params[:categories].present?

  back_path = filters_applied ? expenses_analytics_path : analytics_path
%>

<div class="analytics-header-bar">
  <%= link_to back_path, class: "back-button-inline", title: t("analytics.back") do %>
    <%= image_tag "back.png", class: "wiz-icon", width: 24, height: 24 %>
  <% end %>

  <h1><%= t("analytics.expenses.title") %></h1>

  <%= link_to new_expense_path, class: "add-expense-button", title: t("analytics.expenses.add") do %>
    <%= image_tag "plus.png", class: "wiz-icon", width: 24, height: 24 %>
  <% end %>
</div>

<%= render "shared/analytics_expense_filters" %>

<% if @expenses.present? || @category_filters.present? || @all_time || params[:from].present? || params[:to].present? %>
  <div class="grouped-expense-list">
    <% @grouped_expenses.each do |category, sum| %>

      <% category_params = {
        categories: @category_filters
      } %>

      <% if @all_time %>
        <% category_params[:all_time] = "1" %>
      <% else %>
        <% category_params[:from] = @from.strftime("%d.%m.%Y") %>
        <% category_params[:to] = @to.strftime("%d.%m.%Y") %>
      <% end %>

      <% if @expanded_category != category %>
        <% category_params[:expanded] = category %>
      <% end %>

      <div class="grouped-expense-block">
        <%= link_to expenses_analytics_path(category_params),
              class: "category-summary-link aligned" do %>

          <span class="category-name-text">
            <%= t("analytics.expenses.categories.#{category}") %>
          </span>

          <span class="category-amount">
            <%= sum %> ₴
          </span>
        <% end %>

        <% if @expanded_category == category %>
          <div class="expenses-scroll-wrapper">
            <% @monthly_expenses.each do |month_name, expenses| %>

              <div class="monthly-expense-group"
                  data-controller="collapse">

                <div class="month-header-aligned"
                    data-action="click->collapse#toggle">

                  <span class="month-header-title">
                    <%= month_name %>
                  </span>

                  <div class="month-header-right">
                    <span class="month-header-amount">
                      <%= expenses.sum(&:amount) %> ₴
                    </span>
                  </div>
                </div>

                <ul class="expenses-list collapsible hidden"
                    data-collapse-target="content">

                  <% expenses.each do |expense| %>
                    <li class="expense-item"
                        data-controller="popover">

                      <div class="expense-info">
                        <%= expense.amount %> ₴
                        [<%= l(expense.spent_on, format: :default) %>]

                        <% if expense.note.present? %>
                          — <%= expense.note %>
                        <% end %>
                      </div>

                      <div class="expense-actions">
                        <button class="popover-toggle"
                                data-popover-target="button"
                                data-action="click->popover#toggle">

                          <%= image_tag "pencil.png" %>
                        </button>

                        <div class="popover-menu hidden"
                            data-popover-target="menu">

                          <%= link_to t("analytics.expenses.edit"),
                                edit_expense_path(expense),
                                class: "popover-item" %>

                          <%= button_to expense_path(expense),
                                method: :delete,
                                data: {
                                  turbo_confirm: t("analytics.expenses.confirm_delete")
                                },
                                class: "popover-item delete-button" do %>

                            <%= t("analytics.expenses.delete") %>
                          <% end %>
                        </div>
                      </div>
                    </li>
                  <% end %>

                </ul>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="grouped-expense-total">
    <span>
      <%= t("analytics.period.total_for_period") %>:
    </span>

    <strong>
      <%= @total_expenses.to_i %> ₴
    </strong>
  </div>
<% end %>
