<%
  filters_applied = period_filter_applied? || permitted_params[:categories].present?
%>

<div class="analytics-header-bar">
  <%= link_to analytics_path, class: "back-button-inline",title: t("analytics.back") do %>
    <%= image_tag "back.png", class: "wiz-icon", width: 24, height: 24 %>
  <% end %>

  <h1><%= t("analytics.expenses.title") %></h1>

  <%= link_to new_expense_path, class: "add-expense-button", title: t("analytics.expenses.add") do %>
    <%= image_tag "plus.png", class: "wiz-icon", width: 24, height: 24 %>
  <% end %>
</div>

<%= render "shared/analytics_expense_filters" %>

<% if @expenses.present? %>
  <div class="grouped-expense-list">
    <% @expenses_by_year.each do |year, months| %>
      <% year_total = months.values.flatten.sum(&:amount) %>

      <div class="grouped-expense-block" data-controller="collapse">
        <div class="category-summary-link aligned" data-action="click->collapse#toggle">
          <span class="category-name-text">
            <%= year %>
          </span>

          <span class="category-amount">
            <%= year_total.to_i %> ₴
          </span>
        </div>

        <div class="expenses-scroll-wrapper collapsible hidden" data-collapse-target="content">
          <% months.each do |month_name, expenses| %>
            <div class="monthly-expense-group" data-controller="collapse">
              <div class="month-header-aligned" data-action="click->collapse#toggle">
                <span class="month-header-title">
                  <%= month_name %>
                </span>

                <div class="month-header-right">
                  <span class="month-header-amount">
                    <%= expenses.sum(&:amount).to_i %> ₴
                  </span>
                </div>
              </div>

              <ul class="expenses-list collapsible hidden" data-collapse-target="content">
                <% expenses.each do |expense| %>
                  <li class="expense-item">
                    <div class="expense-record-content">
                      <div class="expense-record-name">
                        <strong>
                          <%= expense.note.presence || expense.category_name %>
                        </strong>
                      </div>

                      <div class="expense-record-details">
                        <span class="expense-record-date">
                          <%= l(expense.spent_on, format: :default) %>
                        </span>

                        <span class="expense-record-amount red">
                          <%= expense.amount.to_i %> ₴
                        </span>
                      </div>
                    </div>

                    <div class="appointment-record-actions">
                      <%= link_to edit_expense_path(expense), class: "appointment-action-button", title: t("analytics.expenses.edit") do %>
                        <%= image_tag "pencil.png", class: "wiz-icon", width: 16, height: 16 %>
                      <% end %>

                      <%= button_to expense_path(expense),
                            method: :delete,
                            form: { data: { turbo_confirm: t("analytics.expenses.confirm_delete") } },
                            class: "appointment-action-button appointment-delete-button",
                            title: t("analytics.expenses.delete") do %>
                        <%= image_tag "delete.png", class: "wiz-icon", width: 16, height: 16 %>
                      <% end %>
                    </div>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="grouped-expense-total">
    <span>
      <%= t("analytics.period.total_for_period") %>:
    </span>

    <strong>
      <%= @total_expenses.to_i %> ₴
    </strong>
  </div>
<% elsif filters_applied %>
  <div class="grouped-expense-list">
    <p><%= t("analytics.expenses.no_results") %></p>
  </div>
<% end %>
