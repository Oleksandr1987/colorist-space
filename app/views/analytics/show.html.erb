<% active_tab = @analytics_tab || "balance" %>

<div class="service-wrapper analytics-page">
  <div class="category-header care-products-header analytics-fixed-header">
    <div class="category-title">
      <%= link_to services_path, class: "back" do %>
        <%= image_tag "back.png", class: "wiz-icon", width: 24, height: 24, alt: "" %>
      <% end %>
      <span><%= t("analytics.title") %></span>
    </div>

    <% if active_tab == "expenses" %>
      <%= link_to new_expense_path, class: "formula-add-button", title: t("analytics.expenses.add") do %>
        <%= image_tag "plus.png", width: 24, height: 24, alt: "" %>
      <% end %>
    <% end %>
  </div>

  <div class="formula-category-tabs analytics-fixed-tabs">
    <div class="formula-category-buttons">
      <% [["balance", t("analytics.menu.balance")],
          ["income", t("analytics.menu.income")],
          ["expenses", t("analytics.menu.expenses")]].each do |tab, title| %>
        <%= link_to analytics_path(tab: tab), class: "filter-button #{'active' if active_tab == tab}" do %>
          <%= title %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="analytics-tab-content analytics-scroll-content">
    <% case active_tab %>
    <% when "balance" %>
      <%= render "shared/analytics_balance_filters" %>
      <%= render "analytics/balance_content" %>
    <% when "income" %>
      <%= render "shared/analytics_income_filters" %>
      <%= render "analytics/income_content" %>
    <% when "expenses" %>
      <%= render "shared/analytics_expense_filters" %>
      <%= render "analytics/expenses_content" %>
    <% end %>
  </div>
</div>
