<% from_date = Date.parse(permitted_params[:from]) rescue nil %>
<% to_date = Date.parse(permitted_params[:to]) rescue nil %>

<% presets = [
  [t("analytics.period_filter.presets.d7"), 7],
  [t("analytics.period_filter.presets.d14"), 14],
  [t("analytics.period_filter.presets.m1"), 30],
  [t("analytics.period_filter.presets.m3"), 90],
  [t("analytics.period_filter.presets.m6"), 180],
  [t("analytics.period_filter.presets.m9"), 270],
  [t("analytics.period_filter.presets.y1"), 365]
] %>

<% active_days =
  if from_date && to_date && to_date == Date.current
    (to_date - from_date).to_i
  end
%>

<div class="analytics-filters sticky-period-filter">

  <!-- PERIOD -->
  <div class="filter-section">
    <div class="filter-title">
      <%= t("analytics.period_filter.period") %>
    </div>

    <div class="filter-chips">
      <% presets.each do |label, days| %>
        <% from_val = days.days.ago.to_date %>
        <% to_val = Date.current %>

        <%= link_to label,
              url_for(
                permitted_params.merge(
                  from: from_val.to_s,
                  to: to_val.to_s
                )
              ),
              class: "filter-chip #{'active' if active_days == days}" %>
      <% end %>
    </div>
  </div>

  <!-- CATEGORY -->
  <% show_category = local_assigns[:show_category] != false %>

  <% if show_category %>
    <div class="filter-section">
      <div class="filter-title">
        <%= t("analytics.period_filter.categories.category") %>
      </div>

      <div class="filter-chips">
        <%= link_to t("analytics.period_filter.categories.all"),
              expenses_analytics_path(
                from: permitted_params[:from],
                to: permitted_params[:to]
              ),
              class: "filter-chip #{'active' if permitted_params[:category].blank?}" %>

        <% Expense::CATEGORIES.each do |cat| %>
          <%= link_to t("analytics.expenses.categories.#{cat}"),
                expenses_analytics_path(
                  from: permitted_params[:from],
                  to: permitted_params[:to],
                  category: cat
                ),
                class: "filter-chip #{'active' if permitted_params[:category] == cat}" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- CUSTOM RANGE -->
  <div class="analytics-custom-range">
    <%= form_with url: request.path,
          method: :get,
          local: true,
          class: "analytics-range-form" do %>

      <div class="analytics-date-fields">
        <div class="form-section">
          <%= label_tag :from,
                t("analytics.period_filter.from"),
                class: "form-label" %>

          <%= text_field_tag :from,
                permitted_params[:from],
                class: "form-input small",
                required: true,
                data: {
                  controller: "datepicker",
                  datepicker_target: "input"
                } %>
        </div>

        <div class="form-section">
          <%= label_tag :to,
                t("analytics.period_filter.to"),
                class: "form-label" %>

          <%= text_field_tag :to,
                permitted_params[:to],
                class: "form-input small",
                required: true,
                data: {
                  controller: "datepicker",
                  datepicker_target: "input"
                } %>
        </div>
      </div>

      <% if permitted_params[:category].present? %>
        <%= hidden_field_tag :category, permitted_params[:category] %>
      <% end %>

      <%= submit_tag t("analytics.period_filter.apply"),
            class: "form-button primary full-width" %>
    <% end %>
  </div>
</div>
