<div class="filter-section">
  <div class="filter-title">
    <%= t("analytics.period_filter.period") %>
  </div>

  <div class="filter-chips">
    <label class="filter-chip <%= "active" if @all_time %>">
      <input type="radio"
             value="all"
             <%= "checked" if @all_time %>
             data-period-option
             data-action="change->analytics-filter#selectAllTime">

      <span>
        <%= t("analytics.period_filter.presets.all_time", default: "За увесь час") %>
      </span>
    </label>

    <% [
      [t("analytics.period_filter.presets.d7"), 7],
      [t("analytics.period_filter.presets.d14"), 14],
      [t("analytics.period_filter.presets.m1"), 30],
      [t("analytics.period_filter.presets.m3"), 90],
      [t("analytics.period_filter.presets.m6"), 180],
      [t("analytics.period_filter.presets.m9"), 270],
      [t("analytics.period_filter.presets.y1"), 365]
    ].each do |label, days| %>
      <% preset_from = Date.current - (days - 1).days %>
      <% preset_active = !@all_time && from_date == preset_from && to_date == Date.current %>

      <label class="filter-chip <%= "active" if preset_active %>">
        <input type="radio"
               value="<%= days %>"
               <%= "checked" if preset_active %>
               data-period-option
               data-action="change->analytics-filter#selectPeriod"
               data-from="<%= preset_from %>"
               data-to="<%= Date.current %>">

        <span><%= label %></span>
      </label>
    <% end %>
  </div>
</div>

<div class="analytics-date-fields">
  <div class="form-section">
    <label class="form-label">
      <%= t("analytics.period_filter.from") %>
    </label>

    <%= text_field_tag nil,
      from_date&.strftime("%d.%m.%Y"),
      class: "form-input small",
      readonly: true,
      autocomplete: "off",
      data: {
        controller: "datepicker",
        datepicker_parent: ".analytics-filter-modal-content",
        analytics_filter_target: "fromDisplay",
        analytics_filter_datepicker_target: "fromPicker",
        action: "datepicker:selected->analytics-filter#fromChanged",
        max: Date.current.strftime("%Y-%m-%d")
      } %>
  </div>

  <div class="form-section">
    <label class="form-label">
      <%= t("analytics.period_filter.to") %>
    </label>

    <%= text_field_tag nil,
      to_date&.strftime("%d.%m.%Y"),
      class: "form-input small",
      readonly: true,
      autocomplete: "off",
      data: {
        controller: "datepicker",
        datepicker_parent: ".analytics-filter-modal-content",
        analytics_filter_target: "toDisplay",
        analytics_filter_datepicker_target: "toPicker",
        action: "datepicker:selected->analytics-filter#toChanged",
        min: from_date&.strftime("%Y-%m-%d"),
        max: Date.current.strftime("%Y-%m-%d")
      } %>
  </div>
</div>

<%= hidden_field_tag :from, from_date&.strftime("%d.%m.%Y"), data: { analytics_filter_target: "from" } %>

<%= hidden_field_tag :to, to_date&.strftime("%d.%m.%Y"), data: { analytics_filter_target: "to" } %>

<%= hidden_field_tag :all_time, @all_time ? "1" : "0", data: { analytics_filter_target: "allTime" } %>
