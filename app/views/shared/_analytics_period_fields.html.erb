<% filter_controller = local_assigns.fetch(:filter_controller, "analytics-filter") %>
<% filter_target_prefix = filter_controller.tr("-", "_") %>
<% period_all_time = local_assigns.fetch(:all_time, @all_time) %>

<div class="filter-section analytics-period-section">
  <div class="analytics-period-header">
    <div class="filter-title">
      <%= t("analytics.period_filter.period") %>
    </div>

    <div class="analytics-date-fields">
      <div class="form-section">
        <%= text_field_tag nil,
          from_date&.strftime("%d.%m.%Y"),
          class: "form-input small",
          placeholder: t("analytics.period_filter.from"),
          aria: { label: t("analytics.period_filter.from") },
          readonly: true,
          autocomplete: "off",
          data: {
            controller: "datepicker",
            datepicker_parent: ".analytics-filter-modal-content",
            "#{filter_target_prefix}_target": "fromDisplay",
            analytics_filter_datepicker_target: "fromPicker",
            action: "datepicker:selected->#{filter_controller}#fromChanged",
            max: Date.current.strftime("%Y-%m-%d")
          } %>
      </div>

      <div class="form-section">
        <%= text_field_tag nil,
          to_date&.strftime("%d.%m.%Y"),
          class: "form-input small",
          placeholder: t("analytics.period_filter.to"),
          aria: { label: t("analytics.period_filter.to") },
          readonly: true,
          autocomplete: "off",
          data: {
            controller: "datepicker",
            datepicker_parent: ".analytics-filter-modal-content",
            "#{filter_target_prefix}_target": "toDisplay",
            analytics_filter_datepicker_target: "toPicker",
            action: "datepicker:selected->#{filter_controller}#toChanged",
            min: from_date&.strftime("%Y-%m-%d"),
            max: Date.current.strftime("%Y-%m-%d")
          } %>
      </div>
    </div>
  </div>

  <div class="filter-chips">
    <label class="filter-chip <%= 'active' if period_all_time %>">
      <input type="radio"
             value="all"
             <%= "checked" if period_all_time %>
             data-period-option
             data-action="change-><%= filter_controller %>#selectAllTime">

      <span>
        <%= t("analytics.period_filter.presets.all_time") %>
      </span>
    </label>

    <% [
      [t("analytics.period_filter.presets.d7"), 7],
      [t("analytics.period_filter.presets.d14"), 14],
      [t("analytics.period_filter.presets.m1"), 30],
      [t("analytics.period_filter.presets.m3"), 90],
      [t("analytics.period_filter.presets.m6"), 180],
      [t("analytics.period_filter.presets.m9"), 270],
      [t("analytics.period_filter.presets.y1"), 365]
    ].each do |label, days| %>

      <% preset_from = Date.current - (days - 1).days %>
      <% preset_active = !period_all_time && from_date == preset_from && to_date == Date.current %>

      <label class="filter-chip <%= 'active' if preset_active %>">
        <input type="radio"
               value="<%= days %>"
               <%= "checked" if preset_active %>
               data-period-option
               data-action="change-><%= filter_controller %>#selectPeriod"
               data-from="<%= preset_from %>"
               data-to="<%= Date.current %>">

        <span><%= label %></span>
      </label>
    <% end %>
  </div>
</div>

<%= hidden_field_tag :from, from_date&.strftime("%d.%m.%Y"), data: { "#{filter_target_prefix}_target": "from" } %>

<%= hidden_field_tag :to, to_date&.strftime("%d.%m.%Y"), data: { "#{filter_target_prefix}_target": "to" } %>

<%= hidden_field_tag :all_time, period_all_time ? "1" : "0", data: { "#{filter_target_prefix}_target": "allTime" } %>
