
<div data-income-group-panel="care_products">
  <% if report.filter_care_products.any? %>
    <div class="filter-section">

      <div class="filter-title analytics-filter-group-title">
        <%= image_tag "skincare.png", class: "analytics-filter-group-icon", width: 24, height: 24, alt: "" %>
        <span><%= t("care_products.title") %></span>
      </div>

      <!-- BRANDS -->
      <div class="filter-subtitle">
        <%= t("care_products.form.brand") %>
      </div>

      <div class="filter-chips" data-income-care-brands>
        <button type="button"
                class="filter-chip"
                data-analytics-filter-target="allCareBrands"
                data-action="click->analytics-filter#selectAllCareBrands">
          <%= t("care_products.form.all_brands") %>
        </button>

        <% report.filter_care_brands.each do |brand| %>
          <% selected = report.filter_care_products.any? do |option|
               report.care_product_filters.include?(option[:id]) && option[:brand] == brand
             end %>

          <label class="filter-chip <%= 'active' if selected %>">
            <input type="checkbox"
                   value="<%= brand %>"
                   <%= "checked" if selected %>
                   data-care-brand="<%= brand %>"
                   data-action="change->analytics-filter#toggleCareBrand">

            <span><%= brand %></span>
          </label>
        <% end %>
      </div>

      <!-- CATEGORIES -->
      <div data-income-care-categories-section class="hidden">

        <div class="filter-subtitle">
          <%= t("analytics.income.category") %>
        </div>

        <div class="filter-chips" data-income-care-categories data-analytics-filter-target="careCategories">
          <button type="button"
                  class="filter-chip"
                  data-analytics-filter-target="allCareCategories"
                  data-action="click->analytics-filter#selectAllCareCategories">
            <%= t("analytics.income.all") %>
          </button>

          <% report.filter_care_categories.each do |category| %>
            <% selected = report.filter_care_products.any? do |option|
                 report.care_product_filters.include?(option[:id]) && option[:category] == category
               end %>

            <label class="filter-chip <%= 'active' if selected %>">
              <input type="checkbox"
                     value="<%= category %>"
                     <%= "checked" if selected %>
                     data-care-category="<%= category %>"
                     data-action="change->analytics-filter#toggleCareCategory">

              <span>
                <%= t("care_products.categories.#{category}", default: category.humanize) %>
              </span>
            </label>
          <% end %>

        </div>
      </div>

      <!-- PRODUCTS -->
      <div class="filter-chips hidden" data-income-care-products data-analytics-filter-target="incomeCareProducts">

        <button type="button"
                class="filter-chip"
                data-analytics-filter-target="allCareProducts"
                data-action="click->analytics-filter#selectAllCareProducts">
          <%= t("analytics.income.all_cp") %>
        </button>

        <% report.filter_care_products.each do |option| %>
          <% selected = report.care_product_filters.include?(option[:id]) %>

          <label class="filter-chip <%= 'active' if selected %>"
                 data-care-product-brand="<%= option[:brand] %>"
                 data-care-product-category="<%= option[:category] %>">

            <%= check_box_tag "care_product_ids[]", option[:id], selected, data: { action: "change->analytics-filter#toggleCareProduct" } %>

            <span><%= option[:label] %></span>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
