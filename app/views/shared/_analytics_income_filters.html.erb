<% report = @income_report %>

<div class="analytics-filter"
     data-controller="analytics-filter"
     data-analytics-filter-options-url-value="<%= analytics_income_filter_options_path %>"
     data-analytics-filter-default-from-value="<%= @from.iso8601 %>"
     data-analytics-filter-default-to-value="<%= @to.iso8601 %>">

  <% if @income_presentation.filters_applied? %>
    <%= link_to analytics_path(tab: "income"), class: "analytics-floating-reset-button" do %>
      <span><%= t("analytics.period_filter.cancel") %></span>
    <% end %>
  <% end %>

  <button type="button"
          class="analytics-floating-filter-button"
          data-action="click->analytics-filter#open"
          title="<%= t('analytics.period_filter.filter') %>"
          aria-label="<%= t('analytics.period_filter.filter') %>">
    <%= image_tag "filter.png", class: "analytics-filter-icon", width: 28, height: 28 %>
    <span><%= t("analytics.period_filter.filter") %></span>
  </button>

  <%= render "shared/analytics_income_filters/active_filters", report: report %>
  <%= render "shared/analytics_income_filters/modal", report: report %>
</div>
