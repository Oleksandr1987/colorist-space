<div class="unsaved-modal hidden" data-unsaved-changes-target="modal">
  <div class="unsaved-modal-backdrop"></div>

  <div class="unsaved-modal-card" role="dialog" aria-modal="true" aria-labelledby="unsaved-changes-message">

    <div class="unsaved-modal-heading">
      <div class="unsaved-modal-icon" aria-hidden="true">
        <%= image_tag "alert.png", alt: "" %>
      </div>

      <p id="unsaved-changes-message">
        <%= t("common.unsaved_changes_message") %>
      </p>
    </div>

    <div class="unsaved-modal-actions">
      <button type="button" class="unsaved-save" data-action="click->unsaved-changes#save">
        <%= t("common.save") %>
      </button>

      <div class="unsaved-secondary-actions">
        <button type="button" class="unsaved-continue" data-action="click->unsaved-changes#cancel">
          <%= t("common.continue_editing") %>
        </button>

        <button type="button" class="unsaved-discard" data-action="click->unsaved-changes#discard">
          <%= t("common.discard") %>
        </button>
      </div>
    </div>
  </div>
</div>
