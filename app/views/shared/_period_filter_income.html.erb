<% from_date = Date.parse(permitted_params[:from]) rescue nil %>
<% to_date = Date.parse(permitted_params[:to]) rescue nil %>

<% presets = [
  [t("analytics.income_filter.presets.d7"), 7],
  [t("analytics.income_filter.presets.d14"), 14],
  [t("analytics.income_filter.presets.m1"), 30],
  [t("analytics.income_filter.presets.m3"), 90],
  [t("analytics.income_filter.presets.m6"), 180],
  [t("analytics.income_filter.presets.m9"), 270],
  [t("analytics.income_filter.presets.y1"), 365]
] %>

<% active_days =
  if from_date && to_date && to_date == Date.current
    (to_date - from_date).to_i
  end
%>

<% all_categories =
  current_user.services
    .where(service_type: "service")
    .distinct
    .pluck(:category)
    .compact
    .sort
%>

<% subtypes =
  if permitted_params[:category].present?
    current_user.services
      .where(
        service_type: "service",
        category: permitted_params[:category]
      )
      .distinct
      .pluck(:subtype)
      .compact
      .sort
  else
    current_user.services
      .where(service_type: "service")
      .distinct
      .pluck(:subtype)
      .compact
      .sort
  end
%>

<div class="analytics-filters sticky-period-filter">

  <!-- PERIOD -->
  <div class="filter-section">
    <div class="filter-title">
      <%= t("analytics.income_filter.period") %>
    </div>

    <div class="filter-chips">
      <% presets.each do |label, days| %>
        <%= link_to label,
              url_for(
                permitted_params.merge(
                  from: days.days.ago.to_date.to_s,
                  to: Date.current.to_s
                )
              ),
              class: "filter-chip #{'active' if active_days == days}" %>
      <% end %>
    </div>
  </div>

  <!-- TYPE -->
  <div class="filter-section">
    <div class="filter-title">
      <%= t("analytics.income_filter.types.type") %>
    </div>

    <div class="filter-chips">
      <%= link_to t("analytics.income_filter.types.all"),
            income_analytics_path(
              from: permitted_params[:from],
              to: permitted_params[:to]
            ),
            class: "filter-chip #{'active' if permitted_params[:service_type].blank?}" %>

      <% %w[service preparation care_product].each do |type| %>
        <%= link_to t("analytics.income_filter.types.#{type}"),
              income_analytics_path(
                from: permitted_params[:from],
                to: permitted_params[:to],
                service_type: type
              ),
              class: "filter-chip #{'active' if permitted_params[:service_type] == type}" %>
      <% end %>
    </div>
  </div>

  <% if permitted_params[:service_type] == "service" %>

    <!-- CATEGORY -->
    <div class="filter-section">
      <div class="filter-title">
        <%= t("analytics.income_filter.categories.category") %>
      </div>

      <div class="filter-chips">
        <%= link_to t("analytics.income_filter.categories.all"),
              income_analytics_path(
                from: permitted_params[:from],
                to: permitted_params[:to],
                service_type: "service"
              ),
              class: "filter-chip #{'active' if permitted_params[:category].blank?}" %>

        <% all_categories.each do |cat| %>
          <%= link_to cat,
                income_analytics_path(
                  from: permitted_params[:from],
                  to: permitted_params[:to],
                  service_type: "service",
                  category: cat
                ),
                class: "filter-chip #{'active' if permitted_params[:category] == cat}" %>
        <% end %>
      </div>
    </div>

    <!-- SUBTYPE -->
    <div class="filter-section">
      <div class="filter-title">
        <%= t("analytics.income_filter.subtypes.subtype") %>
      </div>

      <div class="filter-chips">
        <%= link_to t("analytics.income_filter.subtypes.all"),
              income_analytics_path(
                from: permitted_params[:from],
                to: permitted_params[:to],
                service_type: "service",
                category: permitted_params[:category]
              ),
              class: "filter-chip #{'active' if permitted_params[:subtype].blank?}" %>

        <% subtypes.each do |sub| %>
          <%= link_to sub,
                income_analytics_path(
                  from: permitted_params[:from],
                  to: permitted_params[:to],
                  service_type: "service",
                  category: permitted_params[:category],
                  subtype: sub
                ),
                class: "filter-chip #{'active' if permitted_params[:subtype] == sub}" %>
        <% end %>
      </div>
    </div>

  <% end %>

  <!-- CUSTOM RANGE -->
  <div class="analytics-custom-range">
    <%= form_with url: request.path,
          method: :get,
          local: true,
          class: "analytics-range-form" do %>

      <div class="analytics-date-fields">
        <div class="form-section">
          <%= label_tag :from,
                t("analytics.income_filter.from"),
                class: "form-label" %>

          <%= text_field_tag :from,
                permitted_params[:from],
                class: "form-input small",
                required: true,
                max: Date.current,
                data: {
                  controller: "datepicker",
                  datepicker_target: "input"
                } %>
        </div>

        <div class="form-section">
          <%= label_tag :to,
                t("analytics.income_filter.to"),
                class: "form-label" %>

          <%= text_field_tag :to,
                permitted_params[:to],
                class: "form-input small",
                required: true,
                max: Date.current,
                data: {
                  controller: "datepicker",
                  datepicker_target: "input"
                } %>
        </div>
      </div>

      <%= hidden_field_tag :service_type,
            permitted_params[:service_type] if permitted_params[:service_type].present? %>

      <%= hidden_field_tag :category,
            permitted_params[:category] if permitted_params[:category].present? %>

      <%= hidden_field_tag :subtype,
            permitted_params[:subtype] if permitted_params[:subtype].present? %>

      <%= submit_tag t("analytics.income_filter.apply"),
            class: "form-button primary full-width" %>
    <% end %>
  </div>
</div>
