<% filters_applied = params[:all_time] == "1" || params[:from].present? || params[:to].present? || @category_filters.present? %>
<% from_date = @from %>
<% to_date = @to %>

<div class="analytics-filter" data-controller="analytics-filter">

  <% if filters_applied %>
    <%= link_to expenses_analytics_path, class: "analytics-floating-reset-button" do %>
      <span>
        <%= t("analytics.period_filter.reset", default: "Скинути") %>
      </span>
    <% end %>
  <% end %>

  <button type="button"
          class="analytics-floating-filter-button"
          data-action="click->analytics-filter#open"
          title="<%= t('analytics.period_filter.filters', default: 'Фільтри') %>"
          aria-label="<%= t('analytics.period_filter.filters', default: 'Фільтри') %>">

    <%= image_tag "filter.png", class: "analytics-filter-icon", width: 28, height: 28 %>

    <span>
      <%= t("analytics.period_filter.filters", default: "Фільтри") %>
    </span>
  </button>

  <% if filters_applied %>
    <div class="analytics-active-filters">
      <span class="analytics-active-filter">
        <% if @all_time %>
          <%= t( "analytics.period_filter.presets.all_time", default: "За увесь час") %>
        <% else %>
          <%= @from.strftime("%d.%m.%Y") %>
          –
          <%= @to.strftime("%d.%m.%Y") %>
        <% end %>
      </span>
      <% @category_filters.each do |category| %>
        <span class="analytics-active-filter">
          <%= t("analytics.expenses.categories.#{category}") %>
        </span>
      <% end %>
    </div>
  <% end %>

  <div class="analytics-filter-modal hidden"
       data-analytics-filter-target="modal"
       data-action="click->analytics-filter#closeOnOverlay">

    <div class="analytics-filter-modal-content" data-action="click->analytics-filter#stopPropagation">

      <div class="analytics-filter-modal-header">
        <h2>
          <%= t("analytics.period_filter.filters", default: "Фільтри") %>
        </h2>

        <button type="button" class="analytics-filter-close" data-action="click->analytics-filter#close">
          <%= image_tag "close.png", class: "wiz-icon", width: 24, height: 24 %>
        </button>
      </div>

      <%= form_with url: expenses_analytics_path, method: :get, local: true, class: "analytics-filter-form" do %>
        <!-- PERIOD -->
        <div class="filter-section">
          <div class="filter-title">
            <%= t("analytics.period_filter.period") %>
          </div>

          <div class="filter-chips">
            <label class="filter-chip <%= 'active' if @all_time %>">
              <input
                type="radio"
                value="all"
                <%= "checked" if @all_time %>
                data-action="change->analytics-filter#selectAllTime">

              <span>
                <%= t("analytics.period_filter.presets.all_time", default: "За увесь час") %>
              </span>
            </label>
            <% [
              [t("analytics.period_filter.presets.d7"), 7],
              [t("analytics.period_filter.presets.d14"), 14],
              [t("analytics.period_filter.presets.m1"), 30],
              [t("analytics.period_filter.presets.m3"), 90],
              [t("analytics.period_filter.presets.m6"), 180],
              [t("analytics.period_filter.presets.m9"), 270],
              [t("analytics.period_filter.presets.y1"), 365]
            ].each do |label, days| %>

              <% preset_from = Date.current - (days - 1).days %>
              <% preset_active = from_date == preset_from && to_date == Date.current %>

              <label class="filter-chip <%= 'active' if preset_active %>">
                <input
                  type="radio"
                  value="<%= days %>"
                  <%= "checked" if preset_active %>
                  data-action="change->analytics-filter#selectPeriod"
                  data-from="<%= preset_from %>"
                  data-to="<%= Date.current %>">

                <span><%= label %></span>
              </label>
            <% end %>
          </div>
        </div>
        <!-- CUSTOM PERIOD -->
        <div class="analytics-date-fields">
          <div class="form-section">
            <label class="form-label">
              <%= t("analytics.period_filter.from") %>
            </label>

            <input
              type="text"
              value="<%= from_date.strftime('%d.%m.%Y') %>"
              class="form-input small"
              autocomplete="off"
              data-controller="datepicker"
              data-datepicker-target="input"
              data-analytics-filter-target="fromDisplay"
              data-action="datepicker:selected->analytics-filter#fromChanged">
          </div>

          <div class="form-section">
            <label class="form-label">
              <%= t("analytics.period_filter.to") %>
            </label>

            <input
              type="text"
              value="<%= to_date.strftime('%d.%m.%Y') %>"
              class="form-input small"
              autocomplete="off"
              data-controller="datepicker"
              data-datepicker-target="input"
              data-analytics-filter-target="toDisplay"
              data-action="datepicker:selected->analytics-filter#toChanged">
          </div>
        </div>

        <%= hidden_field_tag :from,
              from_date.strftime("%d.%m.%Y"),
              data: { analytics_filter_target: "from" } %>

        <%= hidden_field_tag :to,
              to_date.strftime("%d.%m.%Y"),
              data: { analytics_filter_target: "to" } %>

        <%= hidden_field_tag :all_time,
              @all_time ? "1" : "0",
              data: { analytics_filter_target: "allTime" } %>
        <!-- CATEGORIES -->
        <div class="filter-section">
          <div class="filter-title">
            <%= t("analytics.period_filter.categories.category") %>
          </div>

          <div class="filter-chips">
            <% Expense::CATEGORIES.each do |category| %>
              <% selected = @category_filters.include?(category) %>

              <label class="filter-chip <%= 'active' if selected %>">
                <%= check_box_tag "categories[]",
                      category,
                      selected,
                      data: {
                        action: "change->analytics-filter#toggleChip"
                      } %>

                <span>
                  <%= t("analytics.expenses.categories.#{category}") %>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="analytics-filter-actions">
          <button type="submit" class="form-button primary">
            <%= t("analytics.period_filter.apply") %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
