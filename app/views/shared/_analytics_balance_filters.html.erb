<%
  filters_applied = period_filter_applied?

  from_date = permitted_params[:from].present? ? @from : nil
  to_date = permitted_params[:to].present? ? @to : nil
%>

<div class="analytics-filter" data-controller="analytics-filter">

  <% if filters_applied %>
    <%= link_to analytics_path(tab: "balance"), class: "analytics-floating-reset-button" do %>
      <span>
        <%= t("analytics.period_filter.cancel") %>
      </span>
    <% end %>
  <% end %>

  <button type="button" class="analytics-floating-filter-button" data-action="click->analytics-filter#open"
          title="<%= t('analytics.period_filter.filter') %>"
          aria-label="<%= t('analytics.period_filter.filter') %>">
    <%= image_tag "filter.png", class: "analytics-filter-icon", width: 28, height: 28 %>

    <span>
      <%= t("analytics.period_filter.filter") %>
    </span>
  </button>

  <% if filters_applied %>
    <div class="analytics-active-filters">
      <span class="analytics-active-filter">
        <% if @all_time %>
          <%= t("analytics.period_filter.presets.all_time") %>
        <% else %>
          <%= @from.strftime("%d.%m.%Y") %>
          –
          <%= @to.strftime("%d.%m.%Y") %>
        <% end %>
      </span>
    </div>
  <% end %>

  <div class="analytics-filter-modal hidden" data-analytics-filter-target="modal" data-action="click->analytics-filter#closeOnOverlay">
    <div class="analytics-filter-modal-content">
      <%= form_with url: analytics_path, method: :get, local: true, class: "analytics-filter-form" do %>

        <%= hidden_field_tag :tab, "balance" %>
        <!-- HEADER -->
        <div class="analytics-filter-modal-header">
          <button type="button" class="analytics-filter-close" data-action="click->analytics-filter#close" aria-label="<%= t('common.close') %>">
            <%= image_tag "close.png", class: "wiz-icon", width: 24, height: 24 %>
          </button>

          <h2>
            <%= t("analytics.period_filter.filter") %>
          </h2>

          <button type="submit" class="analytics-filter-save">
            <%= t("analytics.period_filter.apply").upcase %>
          </button>
        </div>
        <!-- FILTER CONTENT -->
        <div class="analytics-filter-form-content">
          <%= render "shared/analytics_period_fields", from_date: from_date, to_date: to_date %>
        </div>
      <% end %>
    </div>
  </div>
</div>
