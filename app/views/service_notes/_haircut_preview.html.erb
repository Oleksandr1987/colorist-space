
<%
  zone_key = step.zone.to_s.parameterize(separator: "_")

  zone_name = t("haircut.zones.#{zone_key}", default: step.zone.to_s.humanize)
%>

<div class="receipt-preview">
  <h4 class="receipt-preview-zone">
    <%= zone_name %>
  </h4>

  <div class="receipt-table">
    <% if step.instrument.present? %>
      <div class="receipt-row receipt-cols-2">
        <span><%= t("haircut.instrument") %></span>
        <strong><%= t("haircut.instruments.#{step.instrument}") %></strong>
      </div>
    <% end %>

    <% if step.parting.present? %>
      <div class="receipt-row receipt-cols-2">
        <span><%= t("haircut.parting") %></span>
        <strong><%= t("haircut.partings.#{step.parting}") %></strong>
      </div>
    <% end %>

    <% if step.elevation.present? %>
      <div class="receipt-row receipt-cols-2">
        <span><%= t("haircut.elevation") %></span>
        <strong><%= t("haircut.elevations.#{step.elevation}") %></strong>
      </div>
    <% end %>

    <% if step.cut_type.present? %>
      <div class="receipt-row receipt-cols-2">
        <span><%= t("haircut.cut_type") %></span>
        <strong><%= t("haircut.cut_types.#{step.cut_type}") %></strong>
      </div>
    <% end %>
  </div>
</div>
