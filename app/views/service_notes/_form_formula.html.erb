<div class="formula-container"
     data-controller="formula formula-history"
     data-formula-edit-icon-value="<%= asset_path('pencil.png') %>"
     data-formula-delete-icon-value="<%= asset_path('delete.png') %>"
     data-formula-history-appointment-id-value="<%= @appointment.id %>"
     data-formula-history-target-service-note-id-value="<%= @service_note.id %>"
     data-formula-history-url-value="<%= client_formula_history_path(@client) %>"
     data-formula-history-exclude-id-value="<%= @service_note.id %>"
     data-service-note-id="<%= @service_note.id %>"
     data-client-id="<%= @client.id %>"
     data-formula-sections-value="<%= FormulaStep::SECTIONS.index_with { |section| t("formula.sections.#{section}") }.to_json %>"
     data-formula-history-translations-value="<%= {
      title: t('formula.history.title'),
      formulasFound: t('formula.history.formulas_found', count: '__COUNT__'),
      stepsCount: t('formula.history.steps_count', count: '__COUNT__'),
      stepTitle: t('formula.history.step_title', number: '__NUMBER__', section: '__SECTION__'),
      formulaDate: t('formula.history.formula_date', date: '__DATE__'),
      noDate: t('formula.history.no_date'),
      loading: t('formula.history.loading'),
      loadError: t('formula.history.load_error'),
      detailsError: t('formula.history.details_error'),
      selectedCount: t('formula.history.selected_count', selected: '__SELECTED__', total: '__TOTAL__'),
      selectAll: t('formula.history.select_all'),
      deselectAll: t('formula.history.deselect_all'),
      copySelected: t('formula.history.copy_selected', count: '__COUNT__'),
      colors: t('formula.history.colors'),
      additives: t('formula.history.additives'),
      oxidants: t('formula.history.oxidants'),
      processingTime: t('formula.history.processing_time', time: '__TIME__'),
      importError: t('formula.history.import_error'),
      formulaNotEmpty: t('formula.history.formula_not_empty'),
      units: { g: t("formula.units.g"), ml: t("formula.units.ml") }
    }.to_json %>">
  <!-- STEP 1 -->
  <div class="formula-steps" data-formula-target="container">
    <%= f.fields_for :formula_steps do |step_form| %>
      <!-- STEP WRAPPER -->
      <%= render("service_notes/formula_step", step_form: step_form) %>
    <% end %>
  </div>

  <!-- ADD STEP -->
  <% add_step_hidden = @service_note.new_record? && @service_note.formula_steps.empty? %>

  <div class="formula-add-step <%= 'hidden' if add_step_hidden %>"
       data-formula-target="addStep"
       data-controller="collapse">

    <!-- BUTTON -->
    <div class="add-step-btn" data-action="click->collapse#toggle">
      <span>+ <%= t("formula.add_step") %></span>

      <svg class="chevron"
           xmlns="http://www.w3.org/2000/svg"
           viewBox="0 0 24 24"
           fill="none"
           stroke="currentColor"
           stroke-width="2">
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </div>

    <!-- DROPDOWN -->
    <div class="add-step-content hidden" data-collapse-target="content">
      <h5><%= t("formula.add_section") %></h5>

      <%= render "service_notes/formula_section_picker", close_on_select: true %>
    </div>
  </div>

  <% saved_formula_exists = @service_note.formula_steps.any?(&:persisted?) %>

  <% unless saved_formula_exists %>
    <div class="formula-history-action"
        data-formula-history-target="action">

      <button type="button"
              class="formula-history-button"
              data-action="click->formula-history#open">
        <%= image_tag "copy.png", width: 22, height: 22, alt: "", onerror: nil %>

        <span><%= t("formula.history.copy_from_history") %></span>
      </button>
    </div>
  <% end %>
  <!-- EMPTY STEP -->
  <%= render "service_notes/empty_formula_step" if @service_note.formula_steps.empty? %>
  <!-- TEMPLATE -->
  <%= render "service_notes/formula_step_template" %>

  <%= render "service_notes/formula_history_modal" %>
</div>
