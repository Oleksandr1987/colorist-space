<% step_id = step_form.index || step_form.object.id %>

<div id="formula_step_<%= step_form.object.id %>" class="formula-step-wrapper" data-controller="collapse" data-step-id="<%= step_id %>">
  <!-- HEADER -->
  <div class="formula-step-header" data-action="click->collapse#toggle">
    <span>
      <%= t("haircut.step") %>
      <span class="step-number"></span>
    </span>

    <svg class="chevron"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </div>
  <!-- CONTENT -->
  <div class="formula-step-content hidden" data-collapse-target="content">
    <!-- CARD -->
    <div class="formula-card" data-controller="developer" data-step-id="<%= step_id %>">
      <!-- IMPORTANT: SECTION -->
      <%= step_form.hidden_field :section %>
      <!-- HEADER -->
      <div class="formula-header">
        <span>
          <% if step_form.object.section.present? %>
            <%= t("formula.sections.#{step_form.object.section}") %>
          <% end %>
        </span>

        <div class="step-remove">
          <%= step_form.hidden_field :_destroy, value: 0, class: "destroy-field" %>
          <button type="button" data-action="click->formula#removeStep">
            <%= image_tag "close.png", class: "clear-icon" %>
          </button>
        </div>
      </div>

      <!-- INGREDIENT FIELDS -->
      <div data-formula-target="colorsList" hidden>
        <%= step_form.fields_for :formula_ingredients do |ingredient_form| %>
          <% uid = ingredient_form.object.id || SecureRandom.hex(6) %>

          <%= render "service_notes/formula_ingredient_fields", f: ingredient_form, uid: uid %>
        <% end %>
      </div>

      <!-- COLORS -->
      <div class="formula-block">
        <div class="block-title">
          <span>
            <%= image_tag "paint.png", class: "wiz-icon", width: 24, height: 24 %>
            <%= t("formula.colors") %>
          </span>

          <button type="button"
                  class="add-btn-small add-color-btn"
                  data-action="click->formula#openColorModal"
                  data-step-index="<%= step_id %>">
            <%= image_tag "plus.png", class: "add-icon" %>
          </button>
        </div>

        <div class="colors-list" data-color-target="list">
          <% step_form.object.formula_ingredients.each do |ingredient| %>
            <% next if ingredient.kind == "additive" %>

            <div class="color-row-display" data-id="<%= ingredient.id %>">
              <div class="color-left">
                <span class="brand"><%= ingredient.brand %></span>
                <span class="shade"><%= ingredient.shade %></span>
              </div>

              <div class="color-right">
                <span class="amount">
                  <%= ingredient.amount %><%= ingredient.formula_product&.unit || "g" %>
                </span>

                <div class="color-actions">
                  <button type="button" class="edit-btn" data-action="click->formula#editColor">
                    <%= image_tag "pencil.png" %>
                  </button>

                  <button type="button" class="delete-btn" data-action="click->formula#removeColor">
                    <%= image_tag "delete.png" %>
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <template data-formula-target="ingredientTemplate">
          <div class="ingredient-fields" data-id="NEW_ID">
            <% %w[shade brand amount formula_product_id price kind].each do |field| %>
              <input type="hidden"
                    name="service_note[formula_steps_attributes][STEP_ID][formula_ingredients_attributes][NEW_ID][<%= field %>]"
                    data-field="<%= field %>"
                    value="<%= field == 'kind' ? 'color' : '' %>">
            <% end %>

            <input type="hidden"
                  name="service_note[formula_steps_attributes][STEP_ID][formula_ingredients_attributes][NEW_ID][_destroy]"
                  value="0"
                  data-field="destroy">
          </div>
        </template>
      </div>

      <!-- ADDITIVES -->
      <div class="formula-block">
        <div class="block-title">
          <span>
            <%= image_tag "additive.png", class: "wiz-icon", width: 24, height: 24 %>
            <%= t("formula_products.tabs.additives") %>
          </span>

          <button type="button" class="add-btn-small add-additive-btn" data-action="click->formula#openAdditiveModal">
            <%= image_tag "plus.png", class: "add-icon" %>
          </button>
        </div>

        <div class="colors-list" data-additive-list>
          <% step_form.object.formula_ingredients.each do |ingredient| %>
            <% next unless ingredient.kind == "additive" %>

            <div class="color-row-display additive-row-display"
                data-id="<%= ingredient.id %>">
              <div class="color-left">
                <span class="brand"><%= ingredient.brand %></span>
                <span class="shade"><%= ingredient.shade %></span>
              </div>

              <div class="color-right">
                <span class="amount">
                  <%= ingredient.amount %><%= ingredient.formula_product&.unit || "g" %>
                </span>

                <div class="color-actions">
                  <button type="button" class="edit-btn" data-action="click->formula#editAdditive">
                    <%= image_tag "pencil.png" %>
                  </button>

                  <button type="button"
                          class="delete-btn"
                          data-action="click->formula#removeAdditive">
                    <%= image_tag "delete.png" %>
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- DEVELOPER -->
      <div class="formula-block">
        <div class="block-title">
          <span><%= image_tag "percent.png", class: "wiz-icon", width: 24, height: 24 %> <%= t("formula.developer") %></span>
          <button type="button" class="add-btn-small add-dev-btn" data-action="click->developer#openModal">
              <%= image_tag "plus.png", class: "add-icon" %>
          </button>
        </div>

        <%= step_form.hidden_field :oxidant, value: step_form.object.oxidant_data.to_json, data: { developer_target: "input" } %>

        <div class="dev-list"
            data-developer-target="list">
        </div>

        <template data-developer-target="itemTemplate">
          <div class="dev-row-display">
            <div class="dev-left">
              <span class="dev-name"></span>
              <span class="dev-separator">|</span>
              <span class="dev-ratio"></span>
            </div>

            <div class="dev-right">
              <span class="dev-amount"></span>
              <div class="dev-actions">
                <button type="button" class="edit-btn" data-action="click->developer#edit">
                  <%= image_tag "pencil.png" %>
                </button>
                <button type="button" class="delete-btn" data-action="click->developer#remove">
                  <%= image_tag "delete.png" %>
                </button>
              </div>
            </div>
          </div>
        </template>
      </div>
      <!-- TIME -->
      <div class="formula-block">
        <div class="block-title">
          <span>
            <%= image_tag "time.png", class: "wiz-icon", width: 24, height: 24 %>
            <%= t("formula.time") %>
          </span>

          <div class="time-input">
            <%= step_form.text_field :time,
                value: step_form.object.time.to_i.zero? ? nil : step_form.object.time,
                inputmode: "numeric",
                pattern: "[0-9]*",
                class: "input-line",
                placeholder: "0" %>

            <span class="time-unit">
              <%= t("formula.minutes") %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
