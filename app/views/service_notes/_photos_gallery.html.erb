<div id="<%= dom_id(service_note, :photos_gallery) %>" class="photos-grid" data-photo-target="previewGrid">
  <% service_note.decorated_photos.each do |photo| %>
    <div class="photo-item" data-photo-id="<%= photo.id %>"
      data-delete-url="<%= delete_photo_client_service_note_path(client, service_note, photo_id: photo.id) %>">
      <%= image_tag photo.thumb.processed, class: "photo-preview", loading: "lazy" %>

      <button type="button" class="delete-photo" aria-label="<%= t("photos.remove") %>" data-action="click->photo#remove">
        <%= image_tag "remove.png", class: "clear-icon" %>
      </button>
    </div>
  <% end %>
</div>
