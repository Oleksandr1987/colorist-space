<div class="dev-modal hidden"
     data-controller="developer-modal"
     data-developer-modal-target="modal"
     data-action="click->developer-modal#closeOnOverlay">

  <div class="dev-modal-content" data-action="click->developer-modal#stopPropagation">
    <% oxidants = current_user.formula_products.where(category: "oxidant") %>

    <div class="dev-header">
      <button type="button" class="dev-close" data-action="click->developer-modal#close">
        <%= image_tag "close.png", class: "clear-icon" %>
      </button>

      <h2><%= t("developer.oxidant_modal.title") %></h2>

      <% if oxidants.any? %>
        <button type="button" class="dev-save" data-action="click->developer-modal#save" data-developer-modal-target="saveBtn" disabled>
          <%= t("developer.oxidant_modal.save") %>
        </button>
      <% end %>
    </div>

    <div class="dev-body">
      <% if oxidants.any? %>
        <div class="dev-preparations">
          <label>
            <%= t("developer.oxidant_modal.brand") %>
          </label>

          <select class="input-line" data-developer-modal-target="brandSelect" data-action="change->developer-modal#selectBrand">
            <option value="">
              <%= t("developer.oxidant_modal.select_brand") %>
            </option>

            <% oxidants.map(&:brand).uniq.sort.each do |brand| %>
              <option value="<%= brand %>">
                <%= brand %>
              </option>
            <% end %>
          </select>
        </div>

        <div class="dev-preparations">
          <label>
            <%= t("developer.oxidant_modal.oxidant") %>
          </label>

          <select class="input-line" data-developer-modal-target="serviceSelect" data-action="change->developer-modal#selectService">
            <option value="">
              <%= t("developer.oxidant_modal.choose") %>
            </option>

            <% oxidants.each do |oxid| %>
              <option value="<%= oxid.id %>" data-brand="<%= oxid.brand %>" data-name="<%= oxid.name %>" data-price="<%= oxid.price_per_unit %>">
                <%= oxid.name %>
              </option>
            <% end %>
          </select>
        </div>

        <div class="dev-ratio-section">
          <label class="dev-ratio-label">
            <%= t("developer.oxidant_modal.ratio") %>
          </label>

          <div class="dev-ratio">
            <% ["1:1", "1:1.5", "1:2", "1:3"].each do |ratio| %>
              <button type="button" data-action="click->developer-modal#setRatio" data-ratio="<%= ratio %>">
                <%= ratio %>
              </button>
            <% end %>

            <button type="button" class="dev-add-ratio-btn" data-developer-modal-target="customToggle" data-action="click->developer-modal#showCustomRatio">
              <%= t("developer.oxidant_modal.add_ratio") %>
            </button>
          </div>

          <div class="dev-custom-ratio-form hidden" data-developer-modal-target="customRatio">
            <div class="dev-hint">
              <%= t("formula.ratio_hint_html").html_safe %>
            </div>

            <div class="dev-custom-ratio-row">
              <div class="dev-custom-ratio-input">
                <span>1:</span>

                <input type="text"
                      inputmode="decimal"
                      placeholder="2.5"
                      data-developer-modal-target="customInput"
                      data-action="input->developer-modal#normalizeCustomRatio">
              </div>
            </div>

            <div class="dev-custom-ratio-actions">
              <button type="button" class="dev-custom-ratio-cancel" data-action="click->developer-modal#cancelCustomRatio">
                <%= t("common.cancel") %>
              </button>

              <button type="button"class="dev-custom-ratio-add" data-action="click->developer-modal#addCustom">
                <%= t("developer.oxidant_modal.add") %>
              </button>
            </div>
          </div>
        </div>

        <div class="dev-amount">
          <div class="dev-amount-row">
            <label>
              <%= t("developer.oxidant_modal.amount") %>
            </label>

            <input type="text"
                   value="0"
                   class="dev-amount-input"
                   data-developer-modal-target="amountInput"
                   data-action="input->developer-modal#manualAmountChanged">

            <span class="dev-amount-unit">g</span>
          </div>
        </div>

      <% else %>
        <div class="empty-products">
          <%= image_tag "percent.png", width: 48, height: 48 %>
          <p>
            <%= t("formula.oxidant.empty") %>
          </p>

          <%= link_to t("formula.oxidant.add"), new_formula_product_path(category: "oxidant"), class: "button" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
