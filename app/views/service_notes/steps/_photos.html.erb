<div class="service-note-photos"
     data-controller="photo"
     data-photo-remove-icon-value="<%= asset_path("remove.png") %>">
  <div class="photos-actions">
    <label class="upload-btn">
      <%= t("photos.camera") %>

      <input type="file"
             multiple
             accept="image/*"
             capture="environment"
             class="hidden-file-input"
             data-photo-target="picker"
             data-action="change->photo#preview">
    </label>

    <label class="upload-btn light">
      <%= t("photos.gallery") %>

      <input type="file"
             multiple
             accept="image/*"
             class="hidden-file-input"
             data-photo-target="picker"
             data-action="change->photo#preview">
    </label>
  </div>

  <%= f.file_field :photos,
        multiple: true,
        accept: "image/*",
        class: "hidden-file-input",
        data: { photo_target: "input" }
  %>

  <%= render "service_notes/photos_gallery", service_note: @service_note, client: @client %>
</div>
