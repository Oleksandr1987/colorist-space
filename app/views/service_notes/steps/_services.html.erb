<div class="services-list"
     data-controller="service"
     data-service-add-label-value="<%= t("appointments.form.add_services") %>"
     data-service-save-label-value="<%= t("common.save") %>">

  <%= hidden_field_tag "service_note[service_type]",
        "",
        data: { service_target: "type" } %>

  <%= render "shared/service_selector",
      label: t("appointments.form.services"),
      selected_ids: @selected_service_ids,
      selected_names: current_user.services
        .where(id: @selected_service_ids)
        .order(:subtype)
        .map(&:subtype)
        .join(", ") %>
</div>
