<template data-formula-target="template">
  <div class="formula-step-wrapper" data-controller="collapse" data-step-id="NEW_RECORD">
  <!-- STEP HEADER -->
    <div class="formula-step-header" data-action="click->collapse#toggle">
      <div class="formula-step-header-left">
        <svg class="chevron"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2">
          <path d="m6 9 6 6 6-6"/>
        </svg>

        <span>
          <%= t("haircut.step") %>
          <span class="step-number"></span>
        </span>
      </div>

      <button type="button" class="formula-step-delete" data-action="click->formula#removeStep" aria-label="<%= t('common.delete') %>">
        <%= image_tag "close.png", class: "clear-icon" %>
      </button>
    </div>
  <!-- CONTENT -->
    <div class="formula-step-content" data-collapse-target="content">
      <div class="formula-card" data-controller="developer" data-step-id="NEW_RECORD">
        <!-- SECTION -->
        <input type="hidden"
               name="service_note[formula_steps_attributes][NEW_RECORD][section]"
               value="__SECTION_VALUE__" />

        <input type="hidden"
               name="service_note[formula_steps_attributes][NEW_RECORD][id]" />
        <!-- FORMULA HEADER -->
        <div class="formula-header">
          <span class="formula-section-title">
            __SECTION_LABEL__
          </span>

          <div class="step-remove">
            <input type="hidden"
                  name="service_note[formula_steps_attributes][NEW_RECORD][_destroy]"
                  value="0"
                  class="destroy-field">

            <button type="button" class="formula-change-section" data-action="click->formula#openSectionPicker" aria-label="<%= t('formula.add_section') %>">
              <%= image_tag "up-down.png", alt: "", width: 24, height: 24 %>
            </button>
          </div>
        </div>
        <!-- COLORS -->
        <div class="formula-block">
          <div class="block-title">
            <span> <%= image_tag "paint.png", class: "wiz-icon", width: 24, height: 24 %> <%= t("formula.colors") %></span>

            <button type="button" class="add-btn-small add-color-btn" data-action="click->formula#openColorModal">
               <%= image_tag "plus.png", class: "add-icon" %>
            </button>
          </div>
          <!-- DISPLAY LIST -->
          <div class="colors-display"
              data-color-target="list">
          </div>
          <!-- ✅ HIDDEN (Rails nested) -->
          <div class="hidden"
              data-formula-target="colorsList">
          </div>
          <!-- TEMPLATE для нових інгредієнтів -->
          <template data-formula-target="ingredientTemplate">
            <div class="ingredient-fields" data-id="NEW_ID">
              <input type="hidden"
                name="service_note[formula_steps_attributes][STEP_ID][formula_ingredients_attributes][NEW_ID][shade]"
                data-field="shade">

              <input type="hidden"
                name="service_note[formula_steps_attributes][STEP_ID][formula_ingredients_attributes][NEW_ID][brand]"
                data-field="brand">

              <input type="hidden"
                name="service_note[formula_steps_attributes][STEP_ID][formula_ingredients_attributes][NEW_ID][amount]"
                data-field="amount">

              <input type="hidden"
                name="service_note[formula_steps_attributes][STEP_ID][formula_ingredients_attributes][NEW_ID][formula_product_id]"
                data-field="formula_product_id">

              <input type="hidden"
                name="service_note[formula_steps_attributes][STEP_ID][formula_ingredients_attributes][NEW_ID][price]"
                data-field="price">

              <input type="hidden"
                    name="service_note[formula_steps_attributes][STEP_ID][formula_ingredients_attributes][NEW_ID][kind]"
                    value="color"
                    data-field="kind">

              <input type="hidden"
                name="service_note[formula_steps_attributes][STEP_ID][formula_ingredients_attributes][NEW_ID][_destroy]"
                value="0"
                data-field="destroy">
            </div>
          </template>
        </div>
        <!-- DEVELOPER -->
        <div class="formula-block">
          <div class="block-title">
            <span> <%= image_tag "percent.png", class: "wiz-icon", width: 24,height: 24 %> <%= t("formula.developer") %></span>
            <button type="button" class="add-btn-small add-dev-btn" data-action="click->developer#openModal">
               <%= image_tag "plus.png", class: "add-icon" %>
            </button>
          </div>

          <input type="hidden"
            name="service_note[formula_steps_attributes][NEW_RECORD][oxidant]"
            data-developer-target="input" />

          <div class="dev-list"
              data-developer-target="list">
          </div>

          <template data-developer-target="itemTemplate">
            <div class="dev-row-display">
              <div class="dev-left">
                <span class="dev-name"></span>
                <span class="dev-separator">|</span>
                <span class="dev-ratio"></span>
              </div>

              <div class="dev-right">
                <span class="dev-amount"></span>

                <div class="dev-actions">
                  <button type="button" class="edit-btn" data-action="click->developer#edit">
                    <%= image_tag "pencil.png" %>
                  </button>

                  <button type="button" class="delete-btn" data-action="click->developer#remove">
                    <%= image_tag "delete.png" %>
                  </button>
                </div>
              </div>
            </div>
          </template>
        </div>
        <!-- ADDITIVES -->
        <div class="formula-block">
          <div class="block-title">
            <span>
              <%= image_tag "additive.png", class: "wiz-icon", width: 24, height: 24 %>
              <%= t("formula.additives") %>
            </span>

            <button type="button" class="add-btn-small" data-action="click->formula#openAdditiveModal">
              <%= image_tag "plus.png", class: "add-icon" %>
            </button>
          </div>

          <div class="colors-display" data-additive-list></div>
        </div>
        <!-- TIME -->
        <div class="formula-block">
          <div class="block-title">
            <span>
              <%= image_tag "time.png", class: "wiz-icon", width: 24, height: 24 %>
              <%= t("formula.time") %>
            </span>

            <div class="time-input">
              <input type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    name="service_note[formula_steps_attributes][NEW_RECORD][time]"
                    class="input-line"
                    placeholder="0">

              <span class="time-unit">
                <%= t("formula.minutes") %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>
