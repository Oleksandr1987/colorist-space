<div class="formula-step-wrapper empty-haircut-step" data-controller="collapse">
  <!-- HEADER -->
  <div class="formula-step-header" data-action="click->collapse#toggle">
    <span><%= t("haircut.step") %> 1</span>

    <svg class="chevron"
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </div>

  <!-- CONTENT -->
  <div class="formula-step-content" data-collapse-target="content">
    <div class="sections-wrapper">
      <h5><%= t("haircut.select_zone") %></h5>

      <%= render "service_notes/haircut_zone_picker",  close_on_select: false %>
    </div>
  </div>
</div>
