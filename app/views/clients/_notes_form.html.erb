<div class="inline-editor" data-controller="inline-editor">
  <div class="collapse-section" data-inline-editor-target="collapsed">
    <button type="button" class="collapse-toggle" data-action="inline-editor#open">
      <span>
        <%= t("clients.form.note") %>
      </span>

      <%= image_tag "plus.png", class: "add-icon" %>
    </button>
  </div>

  <div class="inline-editor-panel hidden" data-inline-editor-target="expanded">
    <div class="client-inline-editor-header">
      <button type="button" class="client-inline-editor-close" data-action="inline-editor#close">
        <%= image_tag "close.png", class: "wiz-icon-close" %>
      </button>

      <h3 class="client-inline-editor-title">
        <%= t("clients.form.note") %>
      </h3>

      <div class="client-inline-editor-spacer"></div>
    </div>

    <div class="login__field client-note-field">
      <%= f.text_area :note,
            class: "login__input client-note-input",
            rows: 5,
            maxlength: 500,
            placeholder: t("clients.form.note") %>
    </div>
  </div>
</div>
