<div class="client-form-unsaved"
     data-controller="unsaved-changes<%= ' client-duplicates' if @client.new_record? %>"
     data-unsaved-changes-back-url-value="<%= @client.new_record? ? clients_path : client_path(@client) %>"
     <% if @client.new_record? %>
       data-client-duplicates-url-value="<%= duplicates_clients_path %>"
     <% end %>>
  <%= form_with model: @client, local: true, html: { multipart: true, class: "client-form", data: { unsaved_changes_target: "form" } } do |f| %>

    <header class="client-form-header">
      <button type="button"
              class="client-form-back"
              aria-label="<%= t('wizard.back') %>"
              data-action="click->unsaved-changes#close">
        <%= image_tag "back.png", width: 24, height: 24, class: "wiz-icon" %>
      </button>

      <h2 class="client-form-title">
        <%= @client.new_record? ? t("clients.new") : t("clients.edit") %>
      </h2>

      <div class="client-form-header-spacer"></div>
    </header>

    <div class="client-form-content">
      <div class="login__field">
        <%= f.label :first_name do %>
          <%= t("clients.form.first_name") %>
          <span class="required-asterisk">*</span>
        <% end %>

        <%= f.text_field :first_name, class: "login__input", autocomplete: "off",
            data: (@client.new_record? ? { client_duplicates_target: "input", action: "input->client-duplicates#search" } : {}) %>

        <% @client.errors.where(:first_name).each do |error| %>
          <div class="inline-error" role="alert">
            <%= error.message %>
          </div>
        <% end %>

        <% if @client.new_record? %>
          <div class="client-duplicates hidden" data-client-duplicates-target="results">
            <div class="client-duplicates-title">
              <%= t("clients.duplicates.possible_match") %>
            </div>

            <div data-client-duplicates-target="list"></div>

            <button type="button" class="client-duplicates-show-all hidden" data-show-all data-action="click->client-duplicates#showAll">
              <%= t("clients.duplicates.show_all") %>
              (<span data-client-duplicates-target="count">0</span>)
            </button>
          </div>
        <% end %>
      </div>

      <div class="login__field">
        <%= f.label :last_name, t("clients.form.last_name") %>
        <%= f.text_field :last_name, class: "login__input" %>
      </div>

      <div class="login__field">
        <%= f.label :phone do %>
          <%= t("clients.form.phone") %>
          <span class="required-asterisk">*</span>
        <% end %>

        <div class="phone-input-wrapper">
          <%= f.telephone_field :phone, class: "login__input", autocomplete: "tel", data: { controller: "phone-mask" } %>
        </div>

        <% @client.errors.where(:phone).each do |error| %>
          <div class="inline-error" role="alert">
            <%= error.message %>
          </div>
        <% end %>
      </div>

      <div class="login__field" data-controller="phones">
        <div data-phones-target="container">
          <%= f.fields_for :client_phones do |phone_form| %>
            <div class="phone-row">
              <div class="phone-input-wrapper">
                <%= phone_form.telephone_field :phone, class: "login__input", autocomplete: "tel", data: { controller: "phone-mask" } %>
              </div>

              <%= phone_form.hidden_field :_destroy %>

              <button type="button" class="remove-btn" data-action="phones#remove">
                <%= image_tag "close.png", class: "clear-icon" %>
              </button>
            </div>
          <% end %>
        </div>

        <template data-phones-target="template">
          <div class="phone-row">
            <div class="phone-input-wrapper">
              <input type="tel"
                    autocomplete="tel"
                    data-controller="phone-mask"
                    name="client[client_phones_attributes][NEW_RECORD][phone]"
                    class="login__input">
            </div>

            <input type="hidden"
                  name="client[client_phones_attributes][NEW_RECORD][_destroy]"
                  value="false">

            <button type="button" class="remove-btn" data-action="phones#remove">
              <%= image_tag "close.png", class: "clear-icon" %>
            </button>
          </div>
        </template>

        <button type="button" class="add-phone-text" data-action="phones#add">
          <%= t("clients.form.add_phone") %>
        </button>
      </div>

      <div class="login__field" data-controller="birthday-picker">
        <%= f.label :birthday, t("clients.form.birthday") %>

        <input type="text"
              readonly
              class="login__input"
              placeholder="<%= t("clients.form.select_birthday") %>"
              data-action="click->birthday-picker#open"
              data-birthday-picker-target="display">

        <%= f.hidden_field :birthday, data: { birthday_picker_target: "hidden" } %>

        <% @client.errors.where(:birthday).each do |error| %>
          <div class="inline-error" role="alert">
            <%= error.message %>
          </div>
        <% end %>

        <!-- Inline birthday picker -->
        <div class="birthday-picker-inline hidden"
            data-birthday-picker-target="modal">

          <div class="birthday-picker-top">
            <button type="button"
                    class="birthday-picker-cancel"
                    data-action="click->birthday-picker#close">
              <%= t("common.cancel") %>
            </button>

            <button type="button"
                    class="birthday-picker-save"
                    data-action="click->birthday-picker#save">
              <%= t("common.save").upcase %>
            </button>
          </div>

          <div class="birthday-picker">
            <div class="birthday-picker-column birthday-picker-month">
              <div class="birthday-wheel"
                  data-birthday-picker-target="months"
                  data-action="scroll->birthday-picker#scrollMonth">

                <div class="birthday-wheel-spacer"></div>

                <% I18n.t("date.month_names").drop(1).each_with_index do |month, index| %>
                  <div class="birthday-wheel-item"
                      data-month="<%= format("%02d", index + 1) %>">
                    <%= month %>
                  </div>
                <% end %>

                <div class="birthday-wheel-spacer"></div>
              </div>

              <div class="birthday-wheel-selection"></div>
            </div>

            <div class="birthday-picker-column birthday-picker-day">
              <div class="birthday-wheel"
                  data-birthday-picker-target="days"
                  data-action="scroll->birthday-picker#scrollDay">
              </div>

              <div class="birthday-wheel-selection"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="hair-info" class="client-edit-anchor">
        <%= render "hair_info_form", f: f, expanded: false %>
      </div>

      <div id="notes" class="client-edit-anchor">
        <%= render "notes_form", f: f, expanded: false %>
      </div>
    </div>

    <div class="client-form-actions">
      <%= f.submit t("common.save").upcase, class: "client-form-save" %>
    </div>
  <% end %>

  <%= render "shared/modals/unsaved_changes" %>

  <% if @client.new_record? %>
    <div class="client-duplicates-modal hidden" data-client-duplicates-target="modal">
      <div class="client-duplicates-backdrop"
          data-action="click->client-duplicates#closeModal"></div>

      <div class="client-duplicates-modal-card"
          role="dialog"
          aria-modal="true"
          aria-labelledby="client-duplicates-modal-title">

        <div class="client-duplicates-modal-header">
          <h3 id="client-duplicates-modal-title">
            <%= t("clients.duplicates.all_matches") %>
          </h3>

          <button type="button"
                  class="client-duplicates-modal-close"
                  data-action="click->client-duplicates#closeModal"
                  aria-label="<%= t('common.close') %>">
            ×
          </button>
        </div>

        <div class="client-duplicates-modal-list"
            data-client-duplicates-target="modalList"></div>
      </div>
    </div>
  <% end %>
</div>
