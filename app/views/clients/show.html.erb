<div data-controller="client-profile photo" data-client-profile-id-value="<%= @client.id %>" class="client-profile-container">

  <!-- HEADER -->
  <div class="client-header">
    <% if @client.archived? %>
      <span class="client-archived-badge">
        <%= t("clients.archived") %>
      </span>
    <% end %>

    <div class="client-header-main">
      <%= link_to clients_path, class: "client-back-button" do %>
        <%= image_tag "back.png", width: 24, height: 24, class: "wiz-icon" %>
      <% end %>

      <h1 class="client-header-name">
        <%= @client.full_name %>
      </h1>

      <% if @style_appointments.any? %>
        <%= link_to calendar_appointments_path(client_id: @client.id), class: "button small new-appointment-button", data: { turbo: false } do %>
          <span> + </span>
        <% end %>
      <% end %>
    </div>

    <div class="client-header-details">
      <div class="client-birthday">
        <%= image_tag "cake.png", class: "client-birthday-icon" %>

        <% if @client.birthday.present? %>
          <span class="client-birthday-date">
            <%= @client.decorate.formatted_birthday %>
          </span>
        <% end %>
      </div>

      <div class="client-actions-row">
        <%= link_to edit_client_path(@client), class: "client-edit-button" do %>
          <%= image_tag "pencil.png", class: "client-action-icon" %>
        <% end %>

        <%= button_to client_path(@client), method: :delete,
              form: { data: { turbo_confirm: t("clients.show.delete_client_confirm") } }, class: "client-delete-button" do %>
          <%= image_tag "delete.png", class: "client-action-icon" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- TABS -->
  <div class="tabs">
    <button class="tab-button active" data-client-profile-target="tab" data-tab-name="styles" data-action="click->client-profile#showTab">
      <%= t("clients.show.records_tab") %>
    </button>

    <button class="tab-button" data-client-profile-target="tab" data-tab-name="info" data-action="click->client-profile#showTab">
      <%= t("clients.show.info_tab") %>
    </button>
  </div>

  <!-- RECORDS TAB -->
  <%= render "records_tab", client: @client, appointments: @style_appointments %>

  <!-- INFO TAB -->
  <%= render "info_tab", client: @client %>

  <!-- FULLSCREEN -->
  <div data-photo-target="modal" class="fullscreen hidden">
    <div class="fullscreen-backdrop"
         data-action="click->photo#close">
    </div>

    <button class="fullscreen-close" data-action="click->photo#close">
      <%= image_tag "close.png", class: "close-icon" %>
    </button>

    <img data-photo-target="modalImage" class="fullscreen-image" alt="">
  </div>
</div>
