<div class="service-wrapper"
     data-controller="service"
     data-service-formula-filters-value="true"
     data-service-formula-category-value="<%= @formula_category %>"
     data-service-color-new-url-value="<%= new_formula_product_path(category: "color") %>"
     data-service-oxidant-new-url-value="<%= new_formula_product_path(category: "oxidant") %>">
  <div class="category-header care-products-header">
    <div class="category-title">
      <%= link_to services_path, class: "back" do %>
        <%= image_tag "back.png", class: "wiz-icon", width: 24, height: 24 %>
      <% end %>

      <span><%= t("services.pages.formula_ingredients") %></span>
    </div>

    <%= link_to new_formula_product_path(category: "color"), class: "formula-add-button", data: { service_target: "formulaAddButton" } do %>
      <%= image_tag "plus.png", width: 24, height: 24 %>
    <% end %>
  </div>

  <div class="care-products-page-search">
    <input type="text"
           placeholder="<%= t("formula_products.menu.search_placeholder") %>"
           class="formula-search-input"
           data-service-target="search"
           data-action="input->service#filterFormulaProducts">
  </div>

  <%# COLOR / OXIDANT %>
  <div class="care-products-filters">
    <button type="button"
            class="filter-button <%= 'active' if @formula_category == 'color' %>"
            data-formula-category="color"
            data-action="click->service#selectFormulaCategory">
      <%= t("formula_products.tabs.colors") %>
    </button>

    <button type="button"
            class="filter-button <%= 'active' if @formula_category == 'oxidant' %>"
            data-formula-category="oxidant"
            data-action="click->service#selectFormulaCategory">
      <%= t("formula_products.tabs.oxidants") %>
    </button>
  </div>

  <%# COLOR BRANDS %>
  <div data-service-target="colorFilters" class="<%= 'hidden' unless @formula_category == 'color' %>">
    <% if @color_brands.any? %>
      <div class="care-products-filters">
        <% @color_brands.each do |brand| %>
          <button type="button" class="filter-button" data-brand="<%= brand.downcase %>" data-action="click->service#filterFormulaBrand">
            <%= brand %>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# OXIDANT FILTERS %>
  <div data-service-target="oxidantFilters" class="<%= 'hidden' unless @formula_category == 'oxidant' %>">
    <% if @oxidant_brands.any? %>
      <div class="care-products-filters">
        <% @oxidant_brands.each do |brand| %>
          <button type="button" class="filter-button" data-brand="<%= brand.downcase %>" data-action="click->service#filterFormulaBrand">
            <%= brand %>
          </button>
        <% end %>
      </div>
    <% end %>

    <% if @oxidant_percentages.any? %>
      <div class="care-products-filters">
        <% @oxidant_percentages.each do |percentage| %>
          <button type="button" class="filter-button" data-percentage="<%= percentage.downcase %>" data-action="click->service#filterFormulaPercentage">
            <%= percentage %>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="service-list scrollable-service-list" data-service-target="list">
    <% @formula_products.each do |product| %>
      <div id="<%= dom_id(product) %>"
           class="service-item"
           data-name="<%= "#{product.brand} #{product.name}".downcase %>"
           data-category="<%= product.category.to_s.downcase %>"
           data-brand="<%= product.brand.to_s.downcase %>"
           data-percentage="<%= product.percentage.to_s.downcase %>">

        <div class="service-info">
          <div class="service-name">
            <strong><%= product.brand %></strong>
            <%= product.name %>
          </div>

          <div class="service-category">
            <%= t("formula_products.tabs.#{product.category == 'color' ? 'colors' : 'oxidants'}") %>
          </div>

          <div class="service-price">
            <%= product.price_per_unit %> ₴ / <%= product.unit %>
          </div>
        </div>

        <div class="service-actions">
          <%= link_to edit_formula_product_path(product), class: "icon-button", aria: { label: t("common.edit") } do %>
            <%= image_tag "pencil.png", class: "wiz-icon", width: 16, height: 16,alt: t("common.edit") %>
          <% end %>

          <%= button_to formula_product_path(product),
                method: :delete,
                class: "icon-button delete-button",
                aria: { label: t("common.delete") },
                form: { data: { turbo_confirm: t("formula_products.actions.confirm_delete") } } do %>

            <%= image_tag "delete.png", class: "wiz-icon", width: 16, height: 16, alt: t("common.delete") %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
