<%= form_with(model: formula_product, id: "formula-product-form") do |f| %>

  <%= f.hidden_field :category %>

  <div class="form-section">
    <%= f.label :brand, t("formula_products.form.brand") %>
    <%= f.text_field :brand, class: "form-input", required: true %>
  </div>

  <div class="form-section">
    <%= f.label :unit, t("formula_products.form.unit") %>

    <%= f.select :unit,
          [
            [t("formula_products.units.gram"), "g"],
            [t("formula_products.units.milliliter"), "ml"]
          ],
          {},
          class: "form-input" %>
  </div>

  <div class="form-section">
    <%= f.label :price_per_unit, t("formula_products.form.price_per_unit") %>

    <%= f.number_field :price_per_unit,
          class: "form-input",
          step: :any,
          min: 0,
          required: true,
          inputmode: "decimal" %>
  </div>
<% end %>
